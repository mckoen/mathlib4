-- The cone-triangle comparison requires reducing the objectwise shifted cone maps.
set_option backward.isDefEq.respectTransparency false in
lemma cochainShiftTriangle_comm₃ {K L : V} (g : K ⟶ L) (n : ℤ) :
    (n.negOnePow • (CochainComplex.mappingCone.triangle g).mor₃⟦n⟧' ≫
        (shiftFunctorComm V 1 n).hom.app K) ≫
          (𝟙 ((CategoryTheory.shiftFunctor V n).obj K))⟦(1 : ℤ)⟧' =
      (CochainComplex.mappingCone.shiftIso g n).hom ≫
        (CochainComplex.mappingCone.triangle (g⟦n⟧')).mor₃ := by
  change
    ((Triangle.shiftFunctor V n).obj
        (CochainComplex.mappingCone.triangle g)).mor₃ ≫
          (CategoryTheory.shiftFunctor V 1).map
            (𝟙 ((CategoryTheory.shiftFunctor V n).obj K)) =
      (CochainComplex.mappingCone.shiftIso g n).hom ≫
        (CochainComplex.mappingCone.triangle (g⟦n⟧')).mor₃
  have h := (CochainComplex.mappingCone.shiftTriangleIso g n).hom.comm₃
  have h₁ :
      (CochainComplex.mappingCone.shiftTriangleIso g n).hom.hom₁ =
        𝟙 ((CategoryTheory.shiftFunctor V n).obj K) := rfl
  have h₃ :
      (CochainComplex.mappingCone.shiftTriangleIso g n).hom.hom₃ =
        (CochainComplex.mappingCone.shiftIso g n).hom := rfl
  simpa only [h₁, h₃] using h

-- The following three proofs compare module morphisms objectwise with the
-- corresponding signed squares in the ordinary cochain-complex cone triangle.
set_option maxHeartbeats 400000 in
-- Comparing the shifted first cone map requires objectwise reduction.
set_option backward.isDefEq.respectTransparency false in
lemma shiftStandardTriangle_comm₁
    {M N : RightModule (R := R) A} (f : M ⟶ N) (n : ℤ) :
    ((Triangle.shiftFunctor _ n).obj (standardTriangle A f)).mor₁ ≫
        (n.negOnePow • Iso.refl (shift A N n)).hom =
      (Iso.refl (shift A M n)).hom ≫
        (standardTriangle A (strictShiftMap A f n)).mor₁ := by
  change
    (n.negOnePow • f⟦n⟧') ≫
        (n.negOnePow • 𝟙 (shift A N n)) =
      𝟙 (shift A M n) ≫ strictShiftMap A f n
  apply Hom.ext
  funext X
  have hM : ((𝟙 (shift A M n) : shift A M n ⟶ shift A M n)).app X =
      𝟙 ((shift A M n).obj X) := rfl
  have hN : ((𝟙 (shift A N n) : shift A N n ⟶ shift A N n)).app X =
      𝟙 ((shift A N n).obj X) := rfl
  have hUnits {P Q : RightModule (R := R) A} (r : ℤˣ) (g : P ⟶ Q) :
      (r • g).app X = r • g.app X := rfl
  have hStrict : (strictShiftMap A f n).app X = (f.app X)⟦n⟧' := rfl
  simp only [comp_app]
  simp only [hUnits, hM, hN, categoryShiftFunctor_map_app, hStrict,
    Linear.units_smul_comp, Linear.comp_units_smul, smul_smul,
    Int.units_mul_self, one_smul]
  convert ((Category.comp_id ((CategoryTheory.shiftFunctor V n).map (f.app X))).trans
    (Category.id_comp ((CategoryTheory.shiftFunctor V n).map (f.app X))).symm) using 1 <;> rfl

set_option maxHeartbeats 400000 in
-- Comparing the shifted second cone map requires objectwise reduction.
set_option backward.isDefEq.respectTransparency false in
lemma shiftStandardTriangle_comm₂
    {M N : RightModule (R := R) A} (f : M ⟶ N) (n : ℤ) :
    ((Triangle.shiftFunctor _ n).obj (standardTriangle A f)).mor₂ ≫
        (coneShiftIsoStrict A f n).hom =
      (n.negOnePow • Iso.refl (shift A N n)).hom ≫
        (standardTriangle A (strictShiftMap A f n)).mor₂ := by
  change
    (n.negOnePow • (mappingConeInr A f)⟦n⟧') ≫
        (coneShiftIsoStrict A f n).hom =
      (n.negOnePow • 𝟙 (shift A N n)) ≫
        mappingConeInr A (strictShiftMap A f n)
  apply Hom.ext
  funext X
  have hN : ((𝟙 (shift A N n) : shift A N n ⟶ shift A N n)).app X =
      𝟙 ((shift A N n).obj X) := rfl
  have hUnits {P Q : RightModule (R := R) A} (r : ℤˣ) (g : P ⟶ Q) :
      (r • g).app X = r • g.app X := rfl
  have hInr {P Q : RightModule (R := R) A} (g : P ⟶ Q) :
      (mappingConeInr A g).app X =
        CochainComplex.mappingCone.inr (g.app X) := rfl
  have hCone : (coneShiftIsoStrict A f n).hom.app X =
      (CochainComplex.mappingCone.shiftIso (f.app X) n).hom := rfl
  simp only [comp_app, hUnits, hN, hInr, categoryShiftFunctor_map_app,
    hCone]
  convert cochainShiftTriangle_comm₂ (f.app X) n using 1 <;> rfl

set_option maxHeartbeats 400000 in
-- Comparing the shifted third cone map requires objectwise reduction.
set_option backward.isDefEq.respectTransparency false in
lemma shiftStandardTriangle_comm₃
    {M N : RightModule (R := R) A} (f : M ⟶ N) (n : ℤ) :
    ((Triangle.shiftFunctor _ n).obj (standardTriangle A f)).mor₃ ≫
        (Iso.refl (shift A M n)).hom⟦(1 : ℤ)⟧' =
      (coneShiftIsoStrict A f n).hom ≫
        (standardTriangle A (strictShiftMap A f n)).mor₃ := by
  change
    (n.negOnePow • (mappingConeToShift A f)⟦n⟧' ≫
        (shiftFunctorComm (RightModule (R := R) A) 1 n).hom.app M) ≫
          (𝟙 (shift A M n))⟦(1 : ℤ)⟧' =
      (coneShiftIsoStrict A f n).hom ≫
        mappingConeToShift A (strictShiftMap A f n)
  apply Hom.ext
  funext X
  have hM : ((𝟙 (shift A M n) : shift A M n ⟶ shift A M n)).app X =
      𝟙 ((shift A M n).obj X) := rfl
  have hUnits {P Q : RightModule (R := R) A} (r : ℤˣ) (g : P ⟶ Q) :
      (r • g).app X = r • g.app X := rfl
  have hCone : (coneShiftIsoStrict A f n).hom.app X =
      (CochainComplex.mappingCone.shiftIso (f.app X) n).hom := rfl
  simp only [hUnits, hM, mappingConeToShift,
      mappingConeToShiftOfActionEq,
      comp_app, categoryShiftFunctor_map_app, hCone,
      shiftFunctorComm_hom_app_app]
  convert cochainShiftTriangle_comm₃ (f.app X) n using 1 <;> rfl

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- Shifting a standard module cone triangle gives, with the required signs, the
standard cone triangle of the shifted module morphism. -/
noncomputable def shiftStandardTriangleIso
    {M N : RightModule (R := R) A} (f : M ⟶ N) (n : ℤ) :
    (Triangle.shiftFunctor _ n).obj (standardTriangle A f) ≅
      standardTriangle A (strictShiftMap A f n) :=
  Triangle.isoMk _ _ (Iso.refl (shift A M n))
    (n.negOnePow • Iso.refl (shift A N n)) (coneShiftIsoStrict A f n)
    (shiftStandardTriangle_comm₁ A f n)
    (shiftStandardTriangle_comm₂ A f n)
    (shiftStandardTriangle_comm₃ A f n)

set_option backward.isDefEq.respectTransparency false in
/-- The third square of the cone map induced by a homotopy-commutative square. -/
lemma mappingConeMapOfHomotopy_comm₃
    {M₁ N₁ M₂ N₂ : RightModule (R := R) A}
    {f₁ : M₁ ⟶ N₁} {f₂ : M₂ ⟶ N₂}
    {a : M₁ ⟶ M₂} {b : N₁ ⟶ N₂}
    (H : Homotopy A (f₁ ≫ b) (a ≫ f₂)) :
    mappingConeMapOfHomotopy A H ≫
        mappingConeToShift A f₂ =
      mappingConeToShift A f₁ ≫ a⟦(1 : ℤ)⟧' := by
  apply Hom.ext
  funext X
  simpa only [comp_app, mappingConeMapOfHomotopy, mappingConeToShift,
    mappingConeToShiftOfActionEq, categoryShiftFunctor_map_app] using
    CochainComplex.mappingCone.triangleMapOfHomotopy_comm₃ (H.app X)

