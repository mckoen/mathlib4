set_option backward.isDefEq.respectTransparency false in
lemma shiftFunctorAdd'_inv_app_app (M : RightModule (R := R) A)
    (i j k : ℤ) (h : i + j = k) (X : A) :
    ((CategoryTheory.shiftFunctorAdd'
      (RightModule (R := R) A) i j k h).inv.app M).app X =
      (CategoryTheory.shiftFunctorAdd' V i j k h).inv.app (M.obj X) := by
  subst k
  rw [shiftFunctorAdd'_eq_shiftFunctorAdd, shiftFunctorAdd'_eq_shiftFunctorAdd]
