/-- The canonical shift-add isomorphism of right DG modules. -/
noncomputable def shiftAddPointwiseIso (M : RightModule (R := R) A) (n m : ℤ)
    (hs : ∀ X Y, (shift A M (n + m)).action X Y = shiftAction A M (n + m) X Y)
    (ht : ∀ X Y, (shift A (shift A M n) m).action X Y =
      shiftAction A (shift A M n) m X Y)
    (hi : ∀ X Y, (shift A M n).action X Y = shiftAction A M n X Y) :
    shift A M (n + m) ≅ shift A (shift A M n) m where
  hom := shiftAddPointwiseHom A M n m hs ht hi
  inv :=
    { app X := (CategoryTheory.shiftFunctorAdd V n m).inv.app (M.obj X)
      naturality X Y := by
        have hn : (shift A M (n + m)).action X Y ≫
              (CategoryTheory.shiftFunctorAdd V n m).hom.app (M.obj X) =
            ((X ⟶[V] Y) ◁
                (CategoryTheory.shiftFunctorAdd V n m).hom.app (M.obj Y)) ≫
              (shift A (shift A M n) m).action X Y := by
          simpa only [shift, shiftAddPointwiseHom] using
            (shiftAddPointwiseHom A M n m hs ht hi).naturality X Y
        rw [← cancel_mono
          ((CategoryTheory.shiftFunctorAdd V n m).hom.app (M.obj X))]
        rw [Category.assoc, Iso.inv_hom_id_app]
        slice_rhs 2 3 => rw [hn]
        rw [← MonoidalCategory.whiskerLeft_comp_assoc]
        rw [Iso.inv_hom_id_app]
        change (shift A (shift A M n) m).action X Y ≫
            𝟙 ((shift A (shift A M n) m).obj X) =
          ((X ⟶[V] Y) ◁ 𝟙 ((shift A (shift A M n) m).obj Y)) ≫
            (shift A (shift A M n) m).action X Y
        simp }
  hom_inv_id := by
    apply Hom.ext
    funext X
    exact (CategoryTheory.shiftFunctorAdd V n m).hom_inv_id_app (M.obj X)
  inv_hom_id := by
    apply Hom.ext
    funext X
    exact (CategoryTheory.shiftFunctorAdd V n m).inv_hom_id_app (M.obj X)

