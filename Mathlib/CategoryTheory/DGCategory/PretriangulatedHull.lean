lemma shiftFunctorAdd'_hom_app_app (M : RightModule (R := R) A)
    (i j k : ℤ) (h : i + j = k) (X : A) :
    ((CategoryTheory.shiftFunctorAdd'
      (RightModule (R := R) A) i j k h).hom.app M).app X =
      (CategoryTheory.shiftFunctorAdd' V i j k h).hom.app (M.obj X) := by
  subst k
  rw [shiftFunctorAdd'_eq_shiftFunctorAdd, shiftFunctorAdd'_eq_shiftFunctorAdd]
  rfl

