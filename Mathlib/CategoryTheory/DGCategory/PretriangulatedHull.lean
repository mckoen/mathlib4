/-- The inverse zero-shift comparison is also pointwise the standard comparison. -/
lemma shiftZeroIso_inv_app (M : RightModule (R := R) A) (X : A) :
    ((shiftZeroIso A M).inv).app X =
      (CategoryTheory.shiftFunctorZero V ℤ).inv.app (M.obj X) := by
  have h := congrArg (fun f ↦ f.app X) (shiftZeroIso A M).inv_hom_id
  simp only [comp_app, shiftZeroIso_hom_app] at h
  have hId : (𝟙 M : M ⟶ M).app X = 𝟙 (M.obj X) := rfl
  rw [← cancel_mono ((CategoryTheory.shiftFunctorZero V ℤ).hom.app (M.obj X))]
  rw [h]
  simpa only [Functor.id_obj, hId] using
    ((CategoryTheory.shiftFunctorZero V ℤ).inv_hom_id_app (M.obj X)).symm

