/-! ## The module homotopy category's pretriangulation -/

namespace DGCategory.RightModule

variable {R : Type w} [CommRing R]
variable (A : Type u) [DGCategory R A]

local notation "V" => CochainComplex (ModuleCat R) ℤ

/-! ### Coherence of the objectwise module shift -/

instance shiftFunctor_additive (n : ℤ) : (shiftFunctor (R := R) A n).Additive where
  map_add := by
    intro M N f g
    apply Hom.ext
    funext X
    simp only [shiftFunctor_map_app]
    rw [show (f + g).app X = f.app X + g.app X by rfl]
    rw [show (((shiftFunctor (R := R) A n).map f +
        (shiftFunctor (R := R) A n).map g).app X) =
      ((shiftFunctor (R := R) A n).map f).app X +
        ((shiftFunctor (R := R) A n).map g).app X by rfl]
    simp only [shiftFunctor_map_app]
    exact Functor.map_add (CategoryTheory.shiftFunctor V n)

lemma eqToHom_app_rightModule {M N : RightModule (R := R) A} (h : M = N) (X : A) :
    (eqToHom h).app X = eqToHom (congrArg (fun P : RightModule (R := R) A ↦ P.obj X) h) := by
  subst N
  rfl

/-- The zero-shift comparison constructed through the tensor presentation is pointwise the
standard zero-shift comparison for cochain complexes. -/
lemma shiftZeroIso_hom_app (M : RightModule (R := R) A) (X : A) :
    ((shiftZeroIso A M).hom).app X =
      (CategoryTheory.shiftFunctorZero V ℤ).hom.app (M.obj X) := by
  let F := (curriedTensor (ModuleCat R)).map₂CochainComplex.obj (M.obj X)
  have he :
      (CochainComplex.mapBifunctorShift₂Iso (M.obj X) (𝟙_ V)
          (curriedTensor (ModuleCat R)) 0).hom =
        (M.obj X) ◁ (CategoryTheory.shiftFunctorZero V ℤ).hom.app (𝟙_ V) ≫
          (CategoryTheory.shiftFunctorZero V ℤ).inv.app (M.obj X ⊗ (𝟙_ V)) := by
    have h := NatTrans.congr_app
      (congrArg Iso.hom (F.commShiftIso_zero ℤ)) (𝟙_ V)
    simp only [Functor.CommShift.isoZero_hom_app] at h
    change
      (CochainComplex.mapBifunctorShift₂Iso (M.obj X) (𝟙_ V)
          (curriedTensor (ModuleCat R)) 0).hom =
        (M.obj X) ◁ (CategoryTheory.shiftFunctorZero V ℤ).hom.app (𝟙_ V) ≫
          (CategoryTheory.shiftFunctorZero V ℤ).inv.app (M.obj X ⊗ (𝟙_ V)) at h
    exact h
  have hi :
      (CochainComplex.mapBifunctorShift₂Iso (M.obj X) (𝟙_ V)
          (curriedTensor (ModuleCat R)) 0).inv ≫
        (M.obj X) ◁ (CategoryTheory.shiftFunctorZero V ℤ).hom.app (𝟙_ V) =
          (CategoryTheory.shiftFunctorZero V ℤ).hom.app (M.obj X ⊗ (𝟙_ V)) := by
    rw [← cancel_mono
      ((CategoryTheory.shiftFunctorZero V ℤ).inv.app (M.obj X ⊗ (𝟙_ V))),
      Category.assoc, ← he, Iso.inv_hom_id]
    exact ((CategoryTheory.shiftFunctorZero V ℤ).hom_inv_id_app (M.obj X ⊗ (𝟙_ V))).symm
  change
    (CategoryTheory.shiftFunctor V 0).map (ρ_ (M.obj X)).inv ≫
      (CochainComplex.mapBifunctorShift₂Iso (M.obj X) (𝟙_ V)
        (curriedTensor (ModuleCat R)) 0).inv ≫
        (M.obj X) ◁ (CategoryTheory.shiftFunctorZero V ℤ).hom.app (𝟙_ V) ≫
          (ρ_ (M.obj X)).hom =
      (CategoryTheory.shiftFunctorZero V ℤ).hom.app (M.obj X)
  slice_lhs 2 3 => rw [hi]
  rw [(CategoryTheory.shiftFunctorZero V ℤ).hom.naturality_assoc]
  simp

