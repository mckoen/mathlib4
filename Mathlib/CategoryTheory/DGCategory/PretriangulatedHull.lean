lemma contractible_distinguished (X : HomotopyCategory (R := R) A) :
    contractibleTriangle X ∈ distinguishedTriangles A := by
  obtain ⟨X⟩ := X
  refine ⟨_, _, 𝟙 X, ⟨?_⟩⟩
  have h := (isZero_quotient_obj_iff (A := A) (mappingCone A (𝟙 X))).2
    ⟨mappingConeHomotopyToZeroOfId A X⟩
  exact Triangle.isoMk _ _ (Iso.refl _) (Iso.refl _) h.isoZero.symm
    (by simp [RightModule.standardTriangle]) (h.eq_of_tgt _ _)
    (by dsimp [RightModule.standardTriangle]; ext)

lemma distinguished_cocone_triangle
    {X Y : HomotopyCategory (R := R) A} (f : X ⟶ Y) :
    ∃ (Z : HomotopyCategory (R := R) A) (g : Y ⟶ Z) (h : Z ⟶ X⟦1⟧),
      Triangle.mk f g h ∈ distinguishedTriangles A := by
  obtain ⟨f, rfl⟩ := (quotient (R := R) A).map_surjective f
  exact ⟨_, _, _, ⟨_, _, f, ⟨Iso.refl _⟩⟩⟩

