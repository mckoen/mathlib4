/-- The canonical shift-add map with the standard cochain-complex comparison at every
object of the DG category. -/
noncomputable def shiftAddPointwiseHom (M : RightModule (R := R) A) (n m : ℤ)
    (hs : ∀ X Y, (shift A M (n + m)).action X Y = shiftAction A M (n + m) X Y)
    (ht : ∀ X Y, (shift A (shift A M n) m).action X Y =
      shiftAction A (shift A M n) m X Y)
    (hi : ∀ X Y, (shift A M n).action X Y = shiftAction A M n X Y) :
    shift A M (n + m) ⟶ shift A (shift A M n) m where
  app X := (CategoryTheory.shiftFunctorAdd V n m).hom.app (M.obj X)
  naturality X Y := by
    rw [hs X Y, ht X Y]
    simp only [shiftAction]
    rw [hi X Y]
    change
      ((CochainComplex.mapBifunctorShift₂Iso (X ⟶[V] Y) (M.obj Y)
          (curriedTensor (ModuleCat R)) (n + m)).hom ≫
        (M.action X Y)⟦n + m⟧') ≫
          (CategoryTheory.shiftFunctorAdd V n m).hom.app (M.obj X) =
      ((X ⟶[V] Y) ◁ (CategoryTheory.shiftFunctorAdd V n m).hom.app (M.obj Y)) ≫
        (CochainComplex.mapBifunctorShift₂Iso (X ⟶[V] Y) ((M.obj Y)⟦n⟧)
          (curriedTensor (ModuleCat R)) m).hom ≫
          (((CochainComplex.mapBifunctorShift₂Iso (X ⟶[V] Y) (M.obj Y)
            (curriedTensor (ModuleCat R)) n).hom ≫ (M.action X Y)⟦n⟧')⟦m⟧')
    have hc := NatTrans.congr_app (congrArg Iso.hom
      (((curriedTensor (ModuleCat R)).map₂CochainComplex.obj (X ⟶[V] Y)).commShiftIso_add
        n m)) (M.obj Y)
    simp only [Functor.CommShift.isoAdd_hom_app,
      Functor.commShiftIso_map₂CochainComplex_hom_app] at hc
    rw [Category.assoc]
    rw [(CategoryTheory.shiftFunctorAdd V n m).hom.naturality]
    rw [hc]
    simp only [Category.assoc]
    slice_lhs 4 5 =>
      change (CategoryTheory.shiftFunctorAdd V n m).inv.app
          (((curriedTensor (ModuleCat R)).map₂CochainComplex.obj (X ⟶[V] Y)).obj
            (M.obj Y)) ≫
        (CategoryTheory.shiftFunctorAdd V n m).hom.app
          (((curriedTensor (ModuleCat R)).map₂CochainComplex.obj (X ⟶[V] Y)).obj
            (M.obj Y))
      rw [Iso.inv_hom_id_app]
    simp only [Functor.comp_map, Functor.map_comp]
    rfl

