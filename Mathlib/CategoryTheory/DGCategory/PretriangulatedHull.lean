-- Completing a square unfolds both triangle isomorphisms and quotient representatives.
lemma complete_distinguished_triangle_morphism
    (T₁ T₂ : Triangle (HomotopyCategory (R := R) A))
    (hT₁ : T₁ ∈ distinguishedTriangles A)
    (hT₂ : T₂ ∈ distinguishedTriangles A)
    (a : T₁.obj₁ ⟶ T₂.obj₁) (b : T₁.obj₂ ⟶ T₂.obj₂)
    (fac : T₁.mor₁ ≫ b = a ≫ T₂.mor₁) :
    ∃ (c : T₁.obj₃ ⟶ T₂.obj₃), T₁.mor₂ ≫ c = b ≫ T₂.mor₂ ∧
      T₁.mor₃ ≫ a⟦(1 : ℤ)⟧' = c ≫ T₂.mor₃ := by
  obtain ⟨M₁, N₁, f₁, ⟨e₁⟩⟩ := hT₁
  obtain ⟨M₂, N₂, f₂, ⟨e₂⟩⟩ := hT₂
  obtain ⟨a', ha'⟩ : ∃ (a' : (quotient (R := R) A).obj M₁ ⟶
      (quotient (R := R) A).obj M₂),
      a' = e₁.inv.hom₁ ≫ a ≫ e₂.hom.hom₁ := ⟨_, rfl⟩
  obtain ⟨b', hb'⟩ : ∃ (b' : (quotient (R := R) A).obj N₁ ⟶
      (quotient (R := R) A).obj N₂),
      b' = e₁.inv.hom₂ ≫ b ≫ e₂.hom.hom₂ := ⟨_, rfl⟩
  obtain ⟨a'', rfl⟩ := (quotient (R := R) A).map_surjective a'
  obtain ⟨b'', rfl⟩ := (quotient (R := R) A).map_surjective b'
  have H : RightModule.Homotopy A (f₁ ≫ b'') (a'' ≫ f₂) :=
    homotopyOfEq _ _ (by
      have comm₁₁ := e₁.inv.comm₁
      have comm₁₂ := e₂.hom.comm₁
      dsimp at comm₁₁ comm₁₂
      have comm₁₁' :
          (quotient (R := R) A).map f₁ ≫ e₁.inv.hom₂ =
            e₁.inv.hom₁ ≫ T₁.mor₁ := by
        simpa only [RightModule.standardTriangle, Triangle.mk_obj₁,
          Triangle.mk_mor₁] using comm₁₁
      have comm₁₂' :
          T₂.mor₁ ≫ e₂.hom.hom₂ =
            e₂.hom.hom₁ ≫ (quotient (R := R) A).map f₂ := by
        simpa only [RightModule.standardTriangle, Triangle.mk_obj₂,
          Triangle.mk_mor₁] using comm₁₂
      simp only [Functor.map_comp, ha', hb', reassoc_of% comm₁₁',
        reassoc_of% fac, comm₁₂', Category.assoc])
  let γ := e₁.hom ≫ standardTrianglehMapOfHomotopy A H ≫ e₂.inv
  have comm₂ := γ.comm₂
  have comm₃ := γ.comm₃
  dsimp [γ, standardTrianglehMapOfHomotopy] at comm₂ comm₃
  rw [hb'] at comm₂
  simp only [Category.assoc, Iso.hom_inv_id_triangle_hom₂_assoc] at comm₂
  rw [ha'] at comm₃
  simp only [Category.assoc, Iso.hom_inv_id_triangle_hom₁_assoc] at comm₃
  refine ⟨γ.hom₃, ?_, ?_⟩
  · simpa only [triangleCategory_comp, Functor.mapTriangle_obj,
      RightModule.standardTriangle, TriangleMorphism.comp_hom₃,
      Triangle.mk_obj₃, standardTrianglehMapOfHomotopy,
      TriangleMorphism.comm₂_assoc, Triangle.mk_obj₂, Triangle.mk_mor₂,
      Category.assoc, Iso.hom_inv_id_triangle_hom₂, Category.comp_id,
      Iso.hom_inv_id_triangle_hom₂_assoc, γ] using comm₂
  · simpa only [triangleCategory_comp, Functor.mapTriangle_obj,
      RightModule.standardTriangle, TriangleMorphism.comp_hom₃,
      Triangle.mk_obj₃, standardTrianglehMapOfHomotopy, Category.assoc,
      Triangle.mk_obj₁, Iso.hom_inv_id_triangle_hom₁, Category.comp_id,
      Iso.hom_inv_id_triangle_hom₁_assoc, γ] using comm₃

/-! ### The pretriangulated structure -/

-- Elaborating the comparison through `mapTriangle.commShiftIso` requires unfolding
-- both the source and quotient shift structures.
set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
set_option maxHeartbeats 800000 in
-- The comparison unfolds both `mapTriangle` and the quotient shift structure.
/-- The image of a shifted standard module cone triangle is canonically isomorphic
to the standard cone triangle of the shifted module map. -/
noncomputable def shiftTrianglehIso
    {M N : RightModule (R := R) A} (f : M ⟶ N) (n : ℤ) :
    (Triangle.shiftFunctor _ n).obj (standardTriangleh A f) ≅
      standardTriangleh A (RightModule.strictShiftMap A f n) :=
  (((quotient (R := R) A).mapTriangle.commShiftIso n).symm.app _).trans
    ((quotient (R := R) A).mapTriangle.mapIso
      (RightModule.shiftStandardTriangleIso A f n))

/-- The chosen class of standard-cone triangles is closed under every shift. -/
lemma shift_distinguished_triangle
    (T : Triangle (HomotopyCategory (R := R) A))
    (hT : T ∈ distinguishedTriangles A) (n : ℤ) :
    (Triangle.shiftFunctor _ n).obj T ∈ distinguishedTriangles A := by
  obtain ⟨M, N, f, ⟨e⟩⟩ := hT
  exact ⟨_, _, _, ⟨Functor.mapIso _ e ≪≫
    shiftTrianglehIso (A := A) f n⟩⟩

/-- Reverse rotation preserves the chosen class of distinguished triangles. -/
lemma invRotate_distinguished_triangle'
    (T : Triangle (HomotopyCategory (R := R) A))
    (hT : T ∈ distinguishedTriangles A) :
    T.invRotate ∈ distinguishedTriangles A :=
  isomorphic_distinguished _
    (shift_distinguished_triangle (A := A) _
      (rotate_distinguished_triangle' _
        (rotate_distinguished_triangle' _ hT)) _) _
    ((invRotateIsoRotateRotateShiftFunctorNegOne _).app T)

/-- A triangle is distinguished if and only if its rotation is distinguished. -/
lemma rotate_distinguished_triangle
    (T : Triangle (HomotopyCategory (R := R) A)) :
    T ∈ distinguishedTriangles A ↔ T.rotate ∈ distinguishedTriangles A := by
  constructor
  · exact rotate_distinguished_triangle' T
  · intro hT
    exact isomorphic_distinguished _
      (invRotate_distinguished_triangle' (A := A) T.rotate hT) _
      ((triangleRotation _).unitIso.app T)

/-- The canonical pretriangulated structure on the homotopy category of right DG
modules, whose distinguished triangles are exactly the standard cone triangles up
to isomorphism. -/
noncomputable instance pretriangulated :
    Pretriangulated (HomotopyCategory (R := R) A) where
  distinguishedTriangles := distinguishedTriangles A
  isomorphic_distinguished := isomorphic_distinguished
  contractible_distinguished := contractible_distinguished
  distinguished_cocone_triangle := distinguished_cocone_triangle
  rotate_distinguished_triangle := rotate_distinguished_triangle (A := A)
  complete_distinguished_triangle_morphism :=
    complete_distinguished_triangle_morphism

/-- Every standard module cone triangle is distinguished in the canonical
pretriangulated structure. -/
lemma standardTriangleh_distinguished
    {M N : RightModule (R := R) A} (f : M ⟶ N) :
    standardTriangleh A f ∈
      distTriang (HomotopyCategory (R := R) A) := by
  exact ⟨_, _, f, ⟨Iso.refl _⟩⟩

end DGCategory.RightModule.HomotopyCategory

/-! ## Transport and essential-image criteria -/

namespace CategoryTheory

variable {C : Type uC} [Category.{vC} C]
variable {D : Type uD} [Category.{vD} D]

namespace Equivalence

variable (e : C ≌ D)

/-- Pull a zero object back along an equivalence. -/
theorem transportedHasZeroObject (e : C ≌ D) [HasZeroObject D] : HasZeroObject C := by
  apply IsZero.hasZeroObject
  apply IsZero.of_full_of_faithful_of_isZero e.functor (e.inverse.obj 0)
  exact (isZero_zero D).of_iso (e.counitIso.app 0)

/-- The shift on `C` obtained by conjugating the shift on `D` by `e`. -/
def transportedShift [HasShift D ℤ] (n : ℤ) : C ⥤ C :=
  e.functor ⋙ shiftFunctor D n ⋙ e.inverse

/-- The comparison needed by `HasShift.induced` for the conjugated shift. -/
def transportedShiftIso [HasShift D ℤ] (n : ℤ) :
    e.inverse ⋙ e.transportedShift n ≅ shiftFunctor D n ⋙ e.inverse :=
  e.invFunIdAssoc (shiftFunctor D n ⋙ e.inverse)

set_option linter.unusedVariables false in
/-- Pull a coherent integer shift from `D` to `C` along an equivalence. -/
@[instance_reducible]
def transportedHasShift [HasShift D ℤ] : HasShift C ℤ := by
  letI : ((Functor.whiskeringLeft D C C).obj e.inverse).Full := inferInstance
  letI : ((Functor.whiskeringLeft D C C).obj e.inverse).Faithful := inferInstance
  exact HasShift.induced e.inverse ℤ e.transportedShift e.transportedShiftIso

/-- With the transported shift, the inverse equivalence commutes with shift. -/
@[instance_reducible]
def inverseCommShiftTransported [HasShift D ℤ] :
    letI := e.transportedHasShift
    e.inverse.CommShift ℤ := by
  letI := e.transportedHasShift
  exact Functor.CommShift.ofInduced e.inverse ℤ e.transportedShift e.transportedShiftIso

/-- The transported shift is additive when the equivalence and the original shift are additive. -/
theorem transportedShiftAdditive [Preadditive C] [Preadditive D]
    [e.functor.Additive] [HasShift D ℤ] [∀ n : ℤ, (shiftFunctor D n).Additive]
    (n : ℤ) : (e.transportedShift n).Additive := by
  letI : e.inverse.Additive := e.inverse_additive
  dsimp [transportedShift]
  infer_instance

end Equivalence

namespace Pretriangulated

variable [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
  [Preadditive C] [HasZeroObject C] [HasShift C ℤ]
  [∀ n : ℤ, (shiftFunctor C n).Additive]
  (F : C ⥤ D) [F.Additive] [F.CommShift ℤ] [F.Full] [F.Faithful] [F.EssSurj]

/-- The pretriangulation pulled back along a fully faithful, essentially surjective functor.

A triangle in the source is distinguished precisely when its image under `F` is distinguished.
-/
@[instance_reducible]
def ofFullyFaithfulEssSurj : Pretriangulated C where
  distinguishedTriangles := F.mapTriangle.obj ⁻¹' (distTriang D)
  isomorphic_distinguished _ hT₁ _ e :=
    isomorphic_distinguished _ hT₁ _ (F.mapTriangle.mapIso e)
  contractible_distinguished X := by
    refine isomorphic_distinguished _ (contractible_distinguished (F.obj X)) _ ?_
    rw [F.mapTriangle_obj]
    exact Triangle.isoMk _ _ (Iso.refl (F.obj X)) (Iso.refl (F.obj X)) F.mapZeroObject
      (by
        change F.map (𝟙 X) ≫ 𝟙 (F.obj X) = 𝟙 (F.obj X) ≫ 𝟙 (F.obj X)
        exact (F.map_id X) =≫ 𝟙 (F.obj X))
      (by
        change F.map (0 : X ⟶ (0 : C)) ≫ F.mapZeroObject.hom =
          𝟙 (F.obj X) ≫ (0 : F.obj X ⟶ (0 : D))
        rw [F.map_zero, zero_comp, Category.id_comp])
      (by
        change (F.map (0 : (0 : C) ⟶ X⟦(1 : ℤ)⟧) ≫
            (F.commShiftIso (1 : ℤ)).hom.app X) ≫
          (shiftFunctor D 1).map (𝟙 (F.obj X)) = F.mapZeroObject.hom ≫ 0
        rw [F.map_zero, zero_comp, zero_comp]
        exact (Limits.comp_zero (f := F.mapZeroObject.hom)
          (Z := (shiftFunctor D (1 : ℤ)).obj (F.obj X))).symm)
  distinguished_cocone_triangle {X Y} f := by
    obtain ⟨Z', g', h', mem⟩ := distinguished_cocone_triangle (F.map f)
    let eZ : F.obj (F.objPreimage Z') ≅ Z' := F.objObjPreimageIso Z'
    let g : Y ⟶ F.objPreimage Z' := F.preimage (g' ≫ eZ.inv)
    let h : F.objPreimage Z' ⟶ X⟦(1 : ℤ)⟧ :=
      F.preimage (eZ.hom ≫ h' ≫ (F.commShiftIso (1 : ℤ)).inv.app X)
    refine ⟨F.objPreimage Z', g, h, ?_⟩
    change F.mapTriangle.obj (Triangle.mk f g h) ∈ distTriang D
    refine isomorphic_distinguished _ mem _ ?_
    rw [F.mapTriangle_obj]
    exact Triangle.isoMk _ _ (Iso.refl (F.obj X)) (Iso.refl (F.obj Y)) eZ
      (by
        change F.map f ≫ 𝟙 (F.obj Y) = 𝟙 (F.obj X) ≫ F.map f
        exact (Category.comp_id _).trans (Category.id_comp _).symm)
      (by
        simp only [Triangle.mk_mor₂]
        change F.map g ≫ eZ.hom = 𝟙 (F.obj Y) ≫ g'
        calc
          _ = g' := by
            dsimp [g]
            rw [F.map_preimage, Category.assoc, Iso.inv_hom_id, Category.comp_id]
          _ = 𝟙 (F.obj Y) ≫ g' := (Category.id_comp _).symm)
      (by
        simp only [Triangle.mk_mor₃]
        change (F.map h ≫ (F.commShiftIso (1 : ℤ)).hom.app X) ≫
          (shiftFunctor D 1).map (𝟙 (F.obj X)) = eZ.hom ≫ h'
        calc
          _ = F.map h ≫ (F.commShiftIso (1 : ℤ)).hom.app X := by
            rw [Functor.map_id]
            exact Category.comp_id _
          _ = eZ.hom ≫ h' := by
            dsimp [h]
            rw [F.map_preimage]
            rw [Category.assoc, Category.assoc, Iso.inv_hom_id_app]
            exact eZ.hom ≫= Category.comp_id h')
  rotate_distinguished_triangle T :=
    (rotate_distinguished_triangle (F.mapTriangle.obj T)).trans
      (distinguished_iff_of_iso (F.mapTriangleRotateIso.app T))
  complete_distinguished_triangle_morphism T₁ T₂ hT₁ hT₂ a b comm := by
    rcases T₁ with ⟨X₁, X₂, X₃, u₁, v₁, w₁⟩
    rcases T₂ with ⟨Y₁, Y₂, Y₃, u₂, v₂, w₂⟩
    obtain ⟨c, ⟨hc₁, hc₂⟩⟩ := complete_distinguished_triangle_morphism
      (F.mapTriangle.obj (Triangle.mk u₁ v₁ w₁))
      (F.mapTriangle.obj (Triangle.mk u₂ v₂ w₂)) hT₁ hT₂
      (F.map a) (F.map b) (by
        change F.map u₁ ≫ F.map b = F.map a ≫ F.map u₂
        simp only [← F.map_comp, comm])
    change F.obj X₃ ⟶ F.obj Y₃ at c
    change F.map v₁ ≫ c = F.map b ≫ F.map v₂ at hc₁
    change (F.map w₁ ≫ (F.commShiftIso (1 : ℤ)).hom.app X₁) ≫
      (shiftFunctor D 1).map (F.map a) =
        c ≫ (F.map w₂ ≫ (F.commShiftIso (1 : ℤ)).hom.app Y₁) at hc₂
    refine ⟨F.preimage c, ⟨?_, ?_⟩⟩
    · apply F.map_injective
      simp only [F.map_comp, F.map_preimage]
      exact hc₁
    apply F.map_injective
    rw [← cancel_mono ((F.commShiftIso (1 : ℤ)).hom.app Y₁)]
    simp only [F.map_comp, F.map_preimage, Category.assoc,
      F.commShiftIso_hom_naturality]
    simpa only [Category.assoc] using hc₂

end Pretriangulated

namespace Functor

open Pretriangulated

variable {C : Type uC} [Category.{vC} C]
variable {D : Type uD} [Category.{vD} D] [Preadditive D] [HasZeroObject D]
  [HasShift D ℤ] [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]

/-- The essential image of a full functor is a triangulated object property if it is closed under
shifts and if every source morphism has a distinguished cone with third object in the image.

The proof uses only the ordinary pretriangulated axioms. In particular, it does not choose a
triangulation on the source category and cannot be used to insert an unrelated triangulation. -/
theorem essImage_isTriangulated_of_shift_and_cone (F : C ⥤ D) [F.Full] [Nonempty C]
    (shift_mem : ∀ (X : C) (n : ℤ), F.essImage ((shiftFunctor D n).obj (F.obj X)))
    (cone : ∀ {X Y : C} (f : X ⟶ Y),
      ∃ (Z : C) (g : F.obj Y ⟶ F.obj Z) (h : F.obj Z ⟶ (F.obj X)⟦(1 : ℤ)⟧),
        Triangle.mk (F.map f) g h ∈ distTriang D) :
    F.essImage.IsTriangulated := by
  letI closed₃ : F.essImage.IsTriangulatedClosed₃ :=
    ObjectProperty.IsTriangulatedClosed₃.mk' (by
      intro T hT h₁ h₂
      obtain ⟨X, ⟨e₁⟩⟩ := h₁
      obtain ⟨Y, ⟨e₂⟩⟩ := h₂
      let f : X ⟶ Y := F.preimage (e₁.hom ≫ T.mor₁ ≫ e₂.inv)
      obtain ⟨Z, g, h, hS⟩ := cone f
      let S : Triangle D := Triangle.mk (F.map f) g h
      have comm₁ : S.mor₁ ≫ e₂.hom = e₁.hom ≫ T.mor₁ := by
        change F.map f ≫ e₂.hom = e₁.hom ≫ T.mor₁
        dsimp only [f]
        rw [F.map_preimage]
        slice_lhs 3 4 => rw [e₂.inv_hom_id]
        simp
      obtain ⟨c, hc₂, hc₃⟩ :=
        Pretriangulated.complete_distinguished_triangle_morphism
          S T hS hT e₁.hom e₂.hom comm₁
      let φ : S ⟶ T := Triangle.homMk S T e₁.hom e₂.hom c comm₁ hc₂ hc₃
      let e₃ : S.obj₃ ≅ T.obj₃ :=
        @asIso D _ S.obj₃ T.obj₃ φ.hom₃
          (isIso₃_of_isIso₁₂ φ hS hT e₁.isIso_hom e₂.isIso_hom)
      exact ⟨Z, ⟨e₃⟩⟩)
  letI containsZero : F.essImage.ContainsZero :=
    { exists_zero := by
        let X : C := Classical.choice (inferInstance : Nonempty C)
        have hX : F.essImage (F.obj X) := F.obj_mem_essImage X
        have h₀ : F.essImage (contractibleTriangle (F.obj X)).obj₃ :=
          F.essImage.ext_of_isTriangulatedClosed₃
            (contractibleTriangle (F.obj X)) (contractible_distinguished (F.obj X)) hX hX
        exact ⟨0, isZero_zero D, h₀⟩ }
  letI stable : F.essImage.IsStableUnderShift ℤ :=
    { isStableUnderShiftBy := fun n ↦
        { le_shift := by
            intro M hM
            obtain ⟨X, ⟨e⟩⟩ := hM
            exact essImage.ofIso ((shiftFunctor D n).mapIso e) (shift_mem X n) } }
  exact
    { toContainsZero := containsZero
      toIsStableUnderShift := stable
      toIsTriangulatedClosed₂ :=
        ObjectProperty.IsTriangulatedClosed₂.of_isTriangulatedClosed₃ }

end Functor

end CategoryTheory

/-! ## The pretriangulated hull -/

namespace DGCategory

variable {R : Type w} [CommRing R]

local notation "V" => CochainComplex (ModuleCat R) ℤ

namespace PretriangulatedHull

variable (A : Type w) [DGCategory R A]

/-- The right DG modules obtained from representables by adjoining zero, shifts, and cones. -/
inductive Generated : RightModule (R := R) A → Prop
  | representable (X : A) : Generated (RightModule.representable (R := R) A X)
  | zero : Generated (RightModule.zero (R := R) A)
  | shift {M : RightModule (R := R) A} (hM : Generated M) (n : ℤ) :
      Generated (RightModule.shift A M n)
  | cone {M N : RightModule (R := R) A} (hM : Generated M) (hN : Generated N)
      (f : M ⟶ N) : Generated (RightModule.mappingCone A f)

end PretriangulatedHull

/-- The pretriangulated hull of `A`, realized as generated right DG modules. -/
abbrev PretriangulatedHull (A : Type w) [DGCategory R A] :=
  ObjectProperty.FullSubcategory (PretriangulatedHull.Generated (R := R) A)

namespace PretriangulatedHull

variable (A : Type w) [DGCategory R A]

/-- The full DG-subcategory enrichment inherited from right DG modules. -/
noncomputable instance dgCategory : DGCategory R (PretriangulatedHull (R := R) A) where
  Hom M N := M.obj ⟶[V] N.obj
  id M := eId V M.obj
  comp M N P := eComp V M.obj N.obj P.obj
  id_comp M N := e_id_comp V M.obj N.obj
  comp_id M N := e_comp_id V M.obj N.obj
  assoc M N P Q := e_assoc V M.obj N.obj P.obj Q.obj

/-- The enriched inclusion of the pretriangulated hull into right DG modules. -/
abbrev realization :
    EnrichedFunctor V (PretriangulatedHull (R := R) A) (RightModule (R := R) A) where
  obj M := M.obj
  map _ _ := 𝟙 _

/-- The enriched Yoneda functor, corestricted to the pretriangulated hull. -/
abbrev inclusion : EnrichedFunctor V A (PretriangulatedHull (R := R) A) where
  obj X := ⟨RightModule.representable (R := R) A X, Generated.representable X⟩
  map X Y := (RightModule.enrichedYonedaHomIso A X Y).hom
  map_id := RightModule.enrichedYoneda_map_id A
  map_comp := RightModule.enrichedYoneda_map_comp A

end PretriangulatedHull

end DGCategory

open CategoryTheory.Pretriangulated

namespace DGCategory.PretriangulatedHull

variable {R : Type w} [CommRing R]
variable (A : Type w) [DGCategory R A]

local notation "V" => CochainComplex (ModuleCat R) ℤ

noncomputable local instance homotopyRealizationEssImageIsTriangulated :
    (DGCategory.homotopyCategoryFunctor (realization (R := R) A) ⋙
      RightModule.kToHomotopyCategory (R := R) A).essImage.IsTriangulated := by
  let Q := DGCategory.HomotopyCategory.quotient
    (R := R) (C := PretriangulatedHull (R := R) A)
  let Qₘ := RightModule.HomotopyCategory.quotient (R := R) A
  letI : Nonempty
      (DGCategory.HomotopyCategory (R := R) (PretriangulatedHull (R := R) A)) := by
    let Z : PretriangulatedHull (R := R) A :=
      ⟨RightModule.zero (R := R) A, Generated.zero⟩
    exact ⟨Q.obj (ForgetEnrichment.of V Z)⟩
  apply Functor.essImage_isTriangulated_of_shift_and_cone
  · rintro ⟨X⟩ n
    let M : PretriangulatedHull (R := R) A := ForgetEnrichment.to V X
    let N : PretriangulatedHull (R := R) A :=
      ⟨RightModule.shift A M.obj n, Generated.shift M.property n⟩
    refine ⟨Q.obj (ForgetEnrichment.of V N), ⟨?_⟩⟩
    exact (Qₘ.commShiftIso n).app M.obj
  · rintro ⟨X⟩ ⟨Y⟩ f
    obtain ⟨f, rfl⟩ := Q.map_surjective f
    let M : PretriangulatedHull (R := R) A := ForgetEnrichment.to V X
    let N : PretriangulatedHull (R := R) A := ForgetEnrichment.to V Y
    let u : M.obj ⟶ N.obj :=
      RightModule.moduleHomOfZ0 A
        ((realization (R := R) A).forget.map f)
    let C : PretriangulatedHull (R := R) A :=
      ⟨RightModule.mappingCone A u, Generated.cone M.property N.property u⟩
    let S := RightModule.HomotopyCategory.standardTriangleh A u
    refine ⟨Q.obj (ForgetEnrichment.of V C), S.mor₂, S.mor₃, ?_⟩
    change S ∈ distTriang (RightModule.HomotopyCategory (R := R) A)
    exact RightModule.HomotopyCategory.standardTriangleh_distinguished (A := A) u

/-- The zero object on the homotopy category of the pretriangulated hull. -/
noncomputable instance homotopyCategoryHasZeroObject :
    Limits.HasZeroObject
      (DGCategory.HomotopyCategory (R := R) (PretriangulatedHull (R := R) A)) :=
  let F := DGCategory.homotopyCategoryFunctor (realization (R := R) A) ⋙
    RightModule.kToHomotopyCategory (R := R) A
  F.toEssImage.asEquivalence.transportedHasZeroObject

/-- The coherent integer shifts on the homotopy category of the pretriangulated hull. -/
noncomputable instance homotopyCategoryHasShift :
    HasShift
      (DGCategory.HomotopyCategory (R := R) (PretriangulatedHull (R := R) A)) ℤ :=
  let F := DGCategory.homotopyCategoryFunctor (realization (R := R) A) ⋙
    RightModule.kToHomotopyCategory (R := R) A
  F.toEssImage.asEquivalence.transportedHasShift

/-- Every canonical shift on the homotopy category of the pretriangulated hull is additive. -/
noncomputable instance homotopyCategoryShiftAdditive (n : ℤ) :
    (shiftFunctor
      (DGCategory.HomotopyCategory (R := R) (PretriangulatedHull (R := R) A)) n).Additive := by
  let F := DGCategory.homotopyCategoryFunctor (realization (R := R) A) ⋙
    RightModule.kToHomotopyCategory (R := R) A
  let e := F.toEssImage.asEquivalence
  letI : (F.toEssImage ⋙ F.essImage.ι).Additive := by
    change F.Additive
    infer_instance
  letI : e.functor.Additive := by
    change F.toEssImage.Additive
    exact Functor.additive_of_comp_faithful F.toEssImage F.essImage.ι
  exact e.transportedShiftAdditive n

/-- The canonical pretriangulation on the homotopy category of the pretriangulated hull. -/
noncomputable instance homotopyCategoryPretriangulated :
    Pretriangulated
      (DGCategory.HomotopyCategory (R := R) (PretriangulatedHull (R := R) A)) := by
  let F := DGCategory.homotopyCategoryFunctor (realization (R := R) A) ⋙
    RightModule.kToHomotopyCategory (R := R) A
  let e := F.toEssImage.asEquivalence
  letI : (F.toEssImage ⋙ F.essImage.ι).Additive := by
    change F.Additive
    infer_instance
  letI : e.functor.Additive := by
    change F.toEssImage.Additive
    exact Functor.additive_of_comp_faithful F.toEssImage F.essImage.ι
  letI : e.inverse.CommShift ℤ := e.inverseCommShiftTransported
  letI : e.functor.CommShift ℤ := e.symm.commShiftInverse ℤ
  exact CategoryTheory.Pretriangulated.ofFullyFaithfulEssSurj e.functor

end DGCategory.PretriangulatedHull

namespace DGCategory

variable {R : Type w} [CommRing R]

/-- A DG category is pretriangulated when its canonical functor into its pretriangulated
hull is a quasi-equivalence. -/
class IsPretriangulatedDG (A : Type w) [DGCategory R A] : Prop where
  quasiEquivalence :
    (PretriangulatedHull.inclusion (R := R) A).QuasiEquivalence

attribute [instance] IsPretriangulatedDG.quasiEquivalence

variable (A : Type w) [DGCategory R A]
variable [IsPretriangulatedDG (R := R) A]

/-- The zero object on literal `H⁰(A)`, transported from the pretriangulated hull. -/
noncomputable instance homotopyCategoryHasZeroObject :
    Limits.HasZeroObject (HomotopyCategory (R := R) A) :=
  (homotopyCategoryFunctor
    (PretriangulatedHull.inclusion (R := R) A)).asEquivalence.transportedHasZeroObject

/-- The coherent integer shifts on literal `H⁰(A)`, transported from the pretriangulated
hull. -/
noncomputable instance homotopyCategoryHasShift :
    HasShift (HomotopyCategory (R := R) A) ℤ :=
  (homotopyCategoryFunctor
    (PretriangulatedHull.inclusion (R := R) A)).asEquivalence.transportedHasShift

/-- Every canonical shift on literal `H⁰(A)` is additive. -/
noncomputable instance homotopyCategoryShiftAdditive (n : ℤ) :
    (shiftFunctor (HomotopyCategory (R := R) A) n).Additive := by
  let F := homotopyCategoryFunctor
    (PretriangulatedHull.inclusion (R := R) A)
  let e := F.asEquivalence
  letI : e.functor.Additive := by
    change F.Additive
    infer_instance
  exact e.transportedShiftAdditive n

/-- The canonical pretriangulation on literal `H⁰(A)`, pulled back from the
pretriangulated hull. -/
noncomputable instance homotopyCategoryPretriangulated :
    Pretriangulated (HomotopyCategory (R := R) A) := by
  let F := homotopyCategoryFunctor
    (PretriangulatedHull.inclusion (R := R) A)
  let e := F.asEquivalence
  letI : e.functor.Additive := by
    change F.Additive
    infer_instance
  letI : e.inverse.CommShift ℤ := e.inverseCommShiftTransported
  letI : e.functor.CommShift ℤ := e.symm.commShiftInverse ℤ
  exact CategoryTheory.Pretriangulated.ofFullyFaithfulEssSurj e.functor

end DGCategory

