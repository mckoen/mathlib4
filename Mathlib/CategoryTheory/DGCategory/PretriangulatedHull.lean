/-- Every shift functor on the module homotopy category is additive. -/
noncomputable instance shiftFunctor_additive (n : ℤ) :
    (CategoryTheory.shiftFunctor (HomotopyCategory (R := R) A) n).Additive := by
  let Q := quotient (R := R) A
  letI : (Q ⋙ CategoryTheory.shiftFunctor (HomotopyCategory (R := R) A) n).Additive :=
    Functor.additive_of_iso (Q.commShiftIso n)
  exact Q.additive_of_full_essSurj_comp
    (CategoryTheory.shiftFunctor (HomotopyCategory (R := R) A) n)

/-- The standard cone triangle after passage to the module homotopy category. -/
noncomputable abbrev standardTriangleh
    {M N : RightModule (R := R) A} (f : M ⟶ N) :
    Triangle (HomotopyCategory (R := R) A) :=
  (quotient (R := R) A).mapTriangle.obj (RightModule.standardTriangle A f)

