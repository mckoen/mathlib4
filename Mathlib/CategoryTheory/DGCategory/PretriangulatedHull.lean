/-- The third square in the rotation of a standard cone triangle commutes
strictly, with the conventional minus sign on the shifted morphism. -/
lemma rotateComm₃ :
    rotateHom A f ≫
        mappingConeToShiftOfActionEq A (mappingConeInr A f)
          (shift_action A N 1) =
      -shiftMap A f 1 := by
  apply Hom.ext
  funext X
  rw [show (-shiftMap A f 1).app X = -(shiftMap A f 1).app X by rfl]
  rw [shiftMap_app]
  simp only [comp_app]
  change
    (CochainComplex.mappingCone.rotateHomotopyEquiv (f.app X)).hom ≫
        (CochainComplex.mappingCone.triangle
          ((mappingConeInr A f).app X)).mor₃ =
      -(CategoryTheory.shiftFunctor V 1).map (f.app X)
  unfold mappingConeInr
  exact CochainComplex.mappingCone.rotateHomotopyEquiv_comm₃ (f.app X)

