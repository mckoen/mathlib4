    have hObj (P : RightModule (R := R) A) (n : ℤ) (X : A) :
        ((shiftFunctor (R := R) A n).obj P).obj X =
          (CategoryTheory.shiftFunctor V n).obj (P.obj X) := rfl
    apply Hom.ext
    funext X
    simp only [comp_app, hNat, hIso, hZero, shiftZeroIso_inv_app]
    convert shiftFunctorAdd_add_zero_hom_app n (M.obj X) using 1
    all_goals
      try rw [hObj M n X]
      simp [hObj, eqToHom_app_rightModule]
      try dsimp only [shiftFunctor, shift, ofObjIso]

/-- The genuine objectwise shift on right DG modules. -/
noncomputable instance hasShift : HasShift (RightModule (R := R) A) ℤ :=
  hasShiftMk _ _ (shiftMkCore A (fun M n X Y ↦ shift_action A M n X Y))

/-- The shift functors obtained from `hasShift` are the additive objectwise shift functors. -/
noncomputable instance categoryShiftFunctor_additive (n : ℤ) :
    (CategoryTheory.shiftFunctor (RightModule (R := R) A) n).Additive := by
  change (shiftFunctor (R := R) A n).Additive
  infer_instance

/-- Action-compatible module homotopy is preserved by every objectwise shift. -/
noncomputable instance homotopic_isCompatibleWithShift :
    (homotopic (R := R) A).IsCompatibleWithShift ℤ where
  condition n M N f g h := by
    obtain ⟨h⟩ := h
    exact ⟨Homotopy.shift A h n (shift_action A M n) (shift_action A N n)⟩

/-- The induced objectwise shift on the module homotopy category. -/
noncomputable instance homotopyCategoryHasShift :
    HasShift (HomotopyCategory (R := R) A) ℤ :=
  CategoryTheory.HasShift.quotient (homotopic (R := R) A) ℤ

/-- The quotient functor canonically commutes with objectwise shifts. -/
noncomputable instance homotopyCategoryQuotientCommShift :
    (HomotopyCategory.quotient (R := R) A).CommShift ℤ :=
  CategoryTheory.Quotient.functor_commShift (homotopic (R := R) A) ℤ

/-! ### Standard cone triangles and their functoriality up to homotopy -/

set_option backward.isDefEq.respectTransparency false in
/-- The third map of the standard cone triangle, with codomain expressed using the
installed categorical shift. -/
noncomputable def mappingConeToShift
    {M N : RightModule (R := R) A} (f : M ⟶ N) :
    mappingCone A f ⟶ M⟦(1 : ℤ)⟧ :=
  mappingConeToShiftOfActionEq A f (shift_action A M 1)

set_option backward.isDefEq.respectTransparency false in
lemma mappingConeToShift_eq
    {M N : RightModule (R := R) A} (f : M ⟶ N) :
    mappingConeToShift A f =
      mappingConeToShiftOfActionEq A f (shift_action A M 1) := rfl

set_option backward.isDefEq.respectTransparency false in
@[simp]
lemma categoryShiftFunctor_map_app
    {M N : RightModule (R := R) A} (f : M ⟶ N) (n : ℤ) (X : A) :
    (f⟦n⟧').app X = (f.app X)⟦n⟧' := by
  change (shiftMap A f n).app X = (f.app X)⟦n⟧'
  exact shiftMap_app A f n X

set_option backward.isDefEq.respectTransparency false in
lemma categoryShiftFunctor_map
    {M N : RightModule (R := R) A} (f : M ⟶ N) (n : ℤ) :
    f⟦n⟧' = shiftMap A f n := rfl

/-- The standard mapping-cone triangle of right DG modules. -/
noncomputable def standardTriangle
    {M N : RightModule (R := R) A} (f : M ⟶ N) :
    Triangle (RightModule (R := R) A) :=
  Triangle.mk f (mappingConeInr A f) (mappingConeToShift A f)

/-! ### Shifts of standard cone triangles -/

