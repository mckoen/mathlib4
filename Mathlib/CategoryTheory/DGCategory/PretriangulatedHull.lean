-- Constructing the cone map unfolds the quotient representative and its homotopy.
/-- A homotopy-commutative square of module maps induces a morphism of standard
cone triangles in the homotopy category. -/
noncomputable def standardTrianglehMapOfHomotopy
    {M₁ N₁ M₂ N₂ : RightModule (R := R) A}
    {f₁ : M₁ ⟶ N₁} {f₂ : M₂ ⟶ N₂}
    {a : M₁ ⟶ M₂} {b : N₁ ⟶ N₂}
    (H : RightModule.Homotopy A (f₁ ≫ b) (a ≫ f₂)) :
    standardTriangleh A f₁ ⟶ standardTriangleh A f₂ where
  hom₁ := (quotient (R := R) A).map a
  hom₂ := (quotient (R := R) A).map b
  hom₃ := (quotient (R := R) A).map (mappingConeMapOfHomotopy A H)
  comm₁ := by
    dsimp
    simp only [← Functor.map_comp]
    exact eq_of_homotopy _ _ H
  comm₂ := by
    dsimp [RightModule.standardTriangle]
    simp only [← Functor.map_comp]
    rw [mappingConeInr_naturality_mapOfHomotopy]
  comm₃ := by
    dsimp [RightModule.standardTriangle]
    rw [← Functor.map_comp_assoc, RightModule.mappingConeMapOfHomotopy_comm₃,
      Functor.map_comp, Category.assoc, Category.assoc]
    simp

/-- A triangle in the module homotopy category is distinguished precisely when it is
isomorphic to a standard module mapping-cone triangle. -/
def distinguishedTriangles : Set (Triangle (HomotopyCategory (R := R) A)) :=
  {T | ∃ (M N : RightModule (R := R) A) (f : M ⟶ N),
    Nonempty (T ≅ standardTriangleh A f)}

variable {A}

lemma isomorphic_distinguished
    (T₁ : Triangle (HomotopyCategory (R := R) A))
    (hT₁ : T₁ ∈ distinguishedTriangles A)
    (T₂ : Triangle (HomotopyCategory (R := R) A)) (e : T₂ ≅ T₁) :
    T₂ ∈ distinguishedTriangles A := by
  obtain ⟨M, N, f, ⟨e'⟩⟩ := hT₁
  exact ⟨M, N, f, ⟨e ≪≫ e'⟩⟩

lemma rotate_distinguished_triangle'
    (T : Triangle (HomotopyCategory (R := R) A))
    (hT : T ∈ distinguishedTriangles A) :
    T.rotate ∈ distinguishedTriangles A := by
  obtain ⟨M, N, f, ⟨e⟩⟩ := hT
  exact ⟨_, _, _, ⟨(Pretriangulated.rotate _).mapIso e ≪≫ rotateTrianglehIso A f⟩⟩

