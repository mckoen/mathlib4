set_option backward.isDefEq.respectTransparency false in
lemma shiftFunctorComm_hom_app_app (M : RightModule (R := R) A)
    (i j : ℤ) (X : A) :
    ((shiftFunctorComm (RightModule (R := R) A) i j).hom.app M).app X =
      (shiftFunctorComm V i j).hom.app (M.obj X) := by
  rw [shiftFunctorComm_eq _ i j (i + j) rfl,
    shiftFunctorComm_eq _ i j (i + j) rfl]
  simp only [Iso.trans_hom, Iso.symm_hom, NatTrans.comp_app]
  rw [comp_app, shiftFunctorAdd'_inv_app_app,
    shiftFunctorAdd'_hom_app_app]

