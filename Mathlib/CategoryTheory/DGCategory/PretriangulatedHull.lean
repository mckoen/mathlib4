/-!
# Pretriangulated DG categories

This file develops the pretriangulated hull of a DG category. It first constructs the
mapping-cone triangles and their rotations for right DG modules, then equips the module homotopy
category with its canonical pretriangulation. It records the transfer and essential-image results
needed to restrict this structure to the full DG subcategory generated by representables under
zero objects, shifts, and mapping cones.

The canonical enriched Yoneda functor from a DG category into this hull defines
`IsPretriangulatedDG`: a DG category is pretriangulated when that functor is a
quasi-equivalence. In this case the hull's pretriangulation transports to the DG category's own
homotopy category.
-/

@[expose] public section

universe w u vC vD uC uD

noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory
open CategoryTheory.Pretriangulated
open CochainComplex.HomComplex
open scoped ZeroObject

/-! ## Mapping-cone support for right DG modules -/

namespace DGCategory.RightModule

variable {R : Type w} [CommRing R]
variable (A : Type u) [DGCategory R A]

local notation "V" => CochainComplex (ModuleCat R) ℤ

open CochainComplex.HomComplex

section CochainComplexFormulas

variable {K L : CochainComplex (ModuleCat.{w} R) ℤ} (f : K ⟶ L)

/-- The cochain underlying the third map of the standard cone triangle. -/
lemma cochain_ofHom_mappingCone_triangle_mor₃ :
    Cochain.ofHom (CochainComplex.mappingCone.triangle f).mor₃ =
      ((-CochainComplex.mappingCone.fst f).rightShift 1 0 (zero_add 1)).1 := by
  dsimp [CochainComplex.mappingCone.triangle]
  exact CochainComplex.HomComplex.Cocycle.cochain_ofHom_homOf_eq_coe _

end CochainComplexFormulas

section ConeToShift

variable {M N : RightModule (R := R) A} (f : M ⟶ N)

/-- Cochain-level naturality of the third map in the standard module cone triangle. -/
lemma mappingConeToShift_cochain_naturality (X Y : A) :
    (Cochain.ofHom (mappingConeAction A f X Y)).comp
        (Cochain.ofHom (CochainComplex.mappingCone.triangle (f.app X)).mor₃)
        (zero_add 0) =
      (TensorCochain.right (X ⟶[V] Y)
          (Cochain.ofHom (CochainComplex.mappingCone.triangle (f.app Y)).mor₃)).comp
        (Cochain.ofHom (shiftAction A M 1 X Y)) (add_zero 0) := by
  let zX : Cochain (CochainComplex.mappingCone (f.app X)) (M.obj X) 1 :=
    (-CochainComplex.mappingCone.fst (f.app X)).1
  let zY : Cochain (CochainComplex.mappingCone (f.app Y)) (M.obj Y) 1 :=
    (-CochainComplex.mappingCone.fst (f.app Y)).1
  have hneg :
      (Cochain.ofHom (mappingConeAction A f X Y)).comp zX (zero_add 1) =
        (TensorCochain.right (X ⟶[V] Y) zY).comp
          (Cochain.ofHom (M.action X Y)) (add_zero 1) := by
    have h := congrArg Neg.neg (mappingConeAction_fst A f X Y)
    simpa only [zX, zY, Cochain.comp_neg, TensorCochain.right_neg,
      Cochain.neg_comp, Cocycle.coe_neg] using h
  have hshift := congrArg
    (fun γ ↦ γ.rightShift 1 0 (zero_add 1)) hneg
  have hshift' :
      (Cochain.ofHom (mappingConeAction A f X Y)).comp
          (zX.rightShift 1 0 (zero_add 1)) (zero_add 0) =
        ((TensorCochain.right (X ⟶[V] Y) zY).rightShift
            1 0 (zero_add 1)).comp
          (Cochain.ofHom ((M.action X Y)⟦1⟧')) (add_zero 0) := by
    simpa only [TensorCochain.zero_cochain_comp_rightShift,
      TensorCochain.rightShift_comp_ofHom] using hshift
  erw [cochain_ofHom_mappingCone_triangle_mor₃ (f.app X),
    cochain_ofHom_mappingCone_triangle_mor₃ (f.app Y)]
  change (Cochain.ofHom (mappingConeAction A f X Y)).comp
      (zX.rightShift 1 0 (zero_add 1)) (zero_add 0) = _
  rw [hshift']
  change _ =
    (TensorCochain.right (X ⟶[V] Y) (zY.rightShift 1 0 (zero_add 1))).comp
      (Cochain.ofHom
        ((CochainComplex.mapBifunctorShift₂Iso (X ⟶[V] Y) (M.obj Y)
          (curriedTensor (ModuleCat R)) 1).hom ≫ (M.action X Y)⟦1⟧'))
        (add_zero 0)
  rw [Cochain.ofHom_comp]
  rw [← Cochain.comp_assoc]
  · rw [TensorCochain.right_rightShift]
  all_goals omega

/-- The third map of the standard module cone triangle, given an identification
of the transported shift action with its direct signed formula. -/
noncomputable def mappingConeToShiftOfActionEq
    (hM : ∀ X Y, (shift A M 1).action X Y = shiftAction A M 1 X Y) :
    mappingCone A f ⟶ shift A M 1 where
  app X := (CochainComplex.mappingCone.triangle (f.app X)).mor₃
  naturality X Y := by
    rw [hM X Y]
    apply Cochain.ofHom_injective
    erw [Cochain.ofHom_comp, Cochain.ofHom_comp]
    erw [← TensorCochain.right_ofHom]
    exact mappingConeToShift_cochain_naturality A f X Y

end ConeToShift

end DGCategory.RightModule

open CategoryTheory MonoidalCategory

namespace DGCategory.RightModule

variable {R : Type w} [CommRing R]
variable (A : Type u) [DGCategory R A]

local notation "V" => CochainComplex (ModuleCat R) ℤ

open CochainComplex.HomComplex

section CochainComplexFormulas

variable {K₁ L₁ K₂ L₂ : CochainComplex (ModuleCat.{w} R) ℤ}
  {f₁ : K₁ ⟶ L₁} {f₂ : K₂ ⟶ L₂}
variable {a : K₁ ⟶ K₂} {b : L₁ ⟶ L₂}

/-- The cone map induced by a homotopy-commutative square has the expected
component on the shifted source summand. -/
lemma cochain_mapOfHomotopy_fst
    (H : _root_.Homotopy (f₁ ≫ b) (a ≫ f₂)) :
    (Cochain.ofHom (CochainComplex.mappingCone.mapOfHomotopy H)).comp
        (CochainComplex.mappingCone.fst f₂).1 (zero_add 1) =
      (CochainComplex.mappingCone.fst f₁).1.comp
        (Cochain.ofHom a) (add_zero 1) := by
  apply Cochain.ext
  intro p q hpq
  simp [CochainComplex.mappingCone.mapOfHomotopy,
    CochainComplex.mappingCone.descCochain]

/-- The cone map induced by a homotopy-commutative square has the expected
component on the unshifted target summand. -/
lemma cochain_mapOfHomotopy_snd
    (H : _root_.Homotopy (f₁ ≫ b) (a ≫ f₂)) :
    (Cochain.ofHom (CochainComplex.mappingCone.mapOfHomotopy H)).comp
        (CochainComplex.mappingCone.snd f₂) (zero_add 0) =
      (CochainComplex.mappingCone.fst f₁).1.comp
          (Cochain.ofHomotopy H) (add_neg_cancel 1) +
        (CochainComplex.mappingCone.snd f₁).comp
          (Cochain.ofHom b) (add_zero 0) := by
  apply Cochain.ext
  intro p q hpq
  simp [CochainComplex.mappingCone.mapOfHomotopy,
    CochainComplex.mappingCone.descCochain]

/-- Tensoring the first projection formula preserves its matrix form, including
the Koszul signs in the shifted summand. -/
lemma tensor_cochain_mapOfHomotopy_fst (T : CochainComplex (ModuleCat.{w} R) ℤ)
    (H : _root_.Homotopy (f₁ ≫ b) (a ≫ f₂)) :
    (Cochain.ofHom (T ◁ CochainComplex.mappingCone.mapOfHomotopy H)).comp
        (TensorCochain.right T (CochainComplex.mappingCone.fst f₂).1)
        (zero_add 1) =
      (TensorCochain.right T (CochainComplex.mappingCone.fst f₁).1).comp
        (Cochain.ofHom (T ◁ a)) (add_zero 1) := by
  rw [← TensorCochain.right_ofHom]
  rw [← TensorCochain.right_comp]
  rw [cochain_mapOfHomotopy_fst H]
  rw [TensorCochain.right_comp]
  rw [TensorCochain.right_ofHom]

/-- Tensoring the second projection formula preserves its matrix form. -/
lemma tensor_cochain_mapOfHomotopy_snd (T : CochainComplex (ModuleCat.{w} R) ℤ)
    (H : _root_.Homotopy (f₁ ≫ b) (a ≫ f₂)) :
    (Cochain.ofHom (T ◁ CochainComplex.mappingCone.mapOfHomotopy H)).comp
        (TensorCochain.right T (CochainComplex.mappingCone.snd f₂))
        (zero_add 0) =
      (TensorCochain.right T (CochainComplex.mappingCone.fst f₁).1).comp
          (Cochain.ofHomotopy (HomologicalComplex.mapBifunctorMapHomotopy₂
            (𝟙 T) H (curriedTensor (ModuleCat R)) (ComplexShape.up ℤ)))
          (add_neg_cancel 1) +
        (TensorCochain.right T (CochainComplex.mappingCone.snd f₁)).comp
          (Cochain.ofHom (T ◁ b)) (add_zero 0) := by
  rw [← TensorCochain.right_ofHom]
  rw [← TensorCochain.right_comp]
  rw [cochain_mapOfHomotopy_snd H]
  rw [TensorCochain.right_add, TensorCochain.right_comp,
    TensorCochain.right_comp, TensorCochain.right_ofHomotopy,
    TensorCochain.right_ofHom]

end CochainComplexFormulas

section MapOfHomotopy

variable {M₁ N₁ M₂ N₂ : RightModule (R := R) A}
variable {f₁ : M₁ ⟶ N₁} {f₂ : M₂ ⟶ N₂}
variable {a : M₁ ⟶ M₂} {b : N₁ ⟶ N₂}

/-- The usual matrix map between mapping cones induced by a square of module maps
that commutes up to an action-compatible homotopy. -/
noncomputable def mappingConeMapOfHomotopy
    (H : Homotopy A (f₁ ≫ b) (a ≫ f₂)) :
    mappingCone A f₁ ⟶ mappingCone A f₂ where
  app X := CochainComplex.mappingCone.mapOfHomotopy (H.app X)
  naturality X Y := by
    apply HomologicalComplex.Hom.ext
    funext p
    apply CochainComplex.mappingCone.ext_to (f₂.app X) p (p + 1) rfl
    · have hmapX := Cochain.congr_v (cochain_mapOfHomotopy_fst (H.app X))
          p (p + 1) rfl
      have hmapY := Cochain.congr_v
        (tensor_cochain_mapOfHomotopy_fst (X ⟶[V] Y) (H.app Y)) p (p + 1) rfl
      have hact₁ := Cochain.congr_v (mappingConeAction_fst A f₁ X Y) p (p + 1) rfl
      have hact₂ := Cochain.congr_v (mappingConeAction_fst A f₂ X Y) p (p + 1) rfl
      simp only [Cochain.comp_v _ _ (zero_add 1) p p (p + 1) (add_zero p) rfl,
        Cochain.comp_v _ _ (add_zero 1) p (p + 1) (p + 1) rfl
          (add_zero (p + 1)), Cochain.ofHom_v] at hmapX hmapY hact₁ hact₂
      have ha := congrArg (fun k ↦ k.f (p + 1)) (a.naturality X Y)
      simp only [HomologicalComplex.comp_f] at ha
      simp only [HomologicalComplex.comp_f, mappingCone, Category.assoc]
      slice_lhs 2 3 => rw [hmapX]
      slice_lhs 1 2 => rw [hact₁]
      slice_lhs 2 3 => rw [ha]
      slice_rhs 2 3 => rw [hact₂]
      slice_rhs 1 2 => rw [hmapY]
      simp only [Category.assoc]
    · have hmapX := Cochain.congr_v (cochain_mapOfHomotopy_snd (H.app X))
          p p (add_zero p)
      have hmapY := Cochain.congr_v
        (tensor_cochain_mapOfHomotopy_snd (X ⟶[V] Y) (H.app Y)) p p (add_zero p)
      have hfst₁ := Cochain.congr_v (mappingConeAction_fst A f₁ X Y)
        p (p + 1) rfl
      have hsnd₁ := Cochain.congr_v (mappingConeAction_snd A f₁ X Y)
        p p (add_zero p)
      have hsnd₂ := Cochain.congr_v (mappingConeAction_snd A f₂ X Y)
        p p (add_zero p)
      simp only [Cochain.comp_v _ _ (zero_add 0) p p p (add_zero p) (add_zero p),
        Cochain.comp_v _ _ (zero_add 1) p p (p + 1) (add_zero p) rfl,
        Cochain.comp_v _ _ (add_neg_cancel 1) p (p + 1) p rfl (by omega),
        Cochain.comp_v _ _ (add_zero 1) p (p + 1) (p + 1) rfl
          (add_zero (p + 1)), Cochain.ofHom_v, Cochain.ofHomotopy,
        Cochain.mk_v, Cochain.add_v] at hmapX hmapY hfst₁ hsnd₁ hsnd₂
      have hb := congrArg (fun k ↦ k.f p) (b.naturality X Y)
      simp only [HomologicalComplex.comp_f] at hb
      have hH := H.naturality X Y (p + 1) p
      simp only [_root_.Homotopy.compLeft_hom,
        _root_.Homotopy.compRight_hom] at hH
      simp only [HomologicalComplex.comp_f, mappingCone]
      rw [Category.assoc, hmapX]
      rw [Category.assoc, hsnd₂]
      simp only [Preadditive.comp_add, ← Category.assoc]
      rw [hfst₁, hsnd₁]
      simp only [Category.assoc]
      rw [hH, hb]
      simp only [← Category.assoc, ← Preadditive.add_comp]
      rw [hmapY]

/-- The cone map induced by a homotopy-commutative square commutes strictly with
the canonical inclusions of the targets. -/
lemma mappingConeInr_naturality_mapOfHomotopy
    (H : Homotopy A (f₁ ≫ b) (a ≫ f₂)) :
    mappingConeInr A f₁ ≫ mappingConeMapOfHomotopy A H =
      b ≫ mappingConeInr A f₂ := by
  apply Hom.ext
  funext X
  exact CochainComplex.mappingCone.triangleMapOfHomotopy_comm₂ (H.app X)

end MapOfHomotopy

end DGCategory.RightModule

open CategoryTheory MonoidalCategory

namespace DGCategory.RightModule

variable {R : Type w} [CommRing R]
variable (A : Type u) [DGCategory R A]

local notation "V" => CochainComplex (ModuleCat R) ℤ

open CochainComplex.HomComplex

/-- The cochain underlying the standard contraction of the cone of an identity. -/
noncomputable abbrev mappingConeIdContractionCochain
    (K : CochainComplex (ModuleCat R) ℤ) :
    Cochain (CochainComplex.mappingCone (𝟙 K))
      (CochainComplex.mappingCone (𝟙 K)) (-1) :=
  Cochain.ofHomotopy (CochainComplex.mappingCone.homotopyToZeroOfId K)

lemma mappingConeIdContractionCochain_eq (K : CochainComplex (ModuleCat R) ℤ) :
    mappingConeIdContractionCochain K =
      CochainComplex.mappingCone.descCochain (𝟙 K)
        (0 : Cochain K (CochainComplex.mappingCone (𝟙 K)) (-2))
        (CochainComplex.mappingCone.inl (𝟙 K)) (by omega) := by
  apply Cochain.ext
  intro p q hpq
  simp [mappingConeIdContractionCochain,
    CochainComplex.mappingCone.homotopyToZeroOfId,
    CochainComplex.mappingCone.descHomotopy, Cochain.equivHomotopy,
    Cochain.ofHomotopy, hpq]

@[simp]
lemma mappingConeIdContractionCochain_fst
    (K : CochainComplex (ModuleCat R) ℤ) :
    (mappingConeIdContractionCochain K).comp
        (CochainComplex.mappingCone.fst (𝟙 K)).1 (neg_add_cancel 1) =
      CochainComplex.mappingCone.snd (𝟙 K) := by
  rw [mappingConeIdContractionCochain_eq]
  simp [CochainComplex.mappingCone.descCochain]

@[simp]
lemma mappingConeIdContractionCochain_snd
    (K : CochainComplex (ModuleCat R) ℤ) :
    (mappingConeIdContractionCochain K).comp
        (CochainComplex.mappingCone.snd (𝟙 K)) (add_zero (-1)) = 0 := by
  rw [mappingConeIdContractionCochain_eq]
  simp [CochainComplex.mappingCone.descCochain]

lemma mappingConeIdContractionCochain_fst_app
    (M : RightModule (R := R) A) (X : A) :
    (mappingConeIdContractionCochain (M.obj X)).comp
        (CochainComplex.mappingCone.fst (Hom.app (𝟙 M) X)).1
          (neg_add_cancel 1) =
      CochainComplex.mappingCone.snd (Hom.app (𝟙 M) X) := by
  change (mappingConeIdContractionCochain (M.obj X)).comp
      (CochainComplex.mappingCone.fst (𝟙 (M.obj X))).1 (neg_add_cancel 1) =
    CochainComplex.mappingCone.snd (𝟙 (M.obj X))
  exact mappingConeIdContractionCochain_fst (M.obj X)

lemma mappingConeIdContractionCochain_snd_app
    (M : RightModule (R := R) A) (X : A) :
    (mappingConeIdContractionCochain (M.obj X)).comp
        (CochainComplex.mappingCone.snd (Hom.app (𝟙 M) X))
          (add_zero (-1)) = 0 := by
  change (mappingConeIdContractionCochain (M.obj X)).comp
      (CochainComplex.mappingCone.snd (𝟙 (M.obj X))) (add_zero (-1)) = 0
  exact mappingConeIdContractionCochain_snd (M.obj X)

set_option backward.isDefEq.respectTransparency false in
lemma mappingConeIdContraction_naturality_fst
    (M : RightModule (R := R) A) (X Y : A) :
    ((Cochain.ofHom (mappingConeAction A (𝟙 M) X Y)).comp
          (mappingConeIdContractionCochain (M.obj X)) (zero_add (-1))).comp
        (CochainComplex.mappingCone.fst (Hom.app (𝟙 M) X)).1 (neg_add_cancel 1) =
      ((TensorCochain.right (X ⟶[V] Y)
          (mappingConeIdContractionCochain (M.obj Y))).comp
        (Cochain.ofHom (mappingConeAction A (𝟙 M) X Y))
          (add_zero (-1))).comp
            (CochainComplex.mappingCone.fst (Hom.app (𝟙 M) X)).1
              (neg_add_cancel 1) := by
  rw [Cochain.comp_assoc_of_first_is_zero_cochain]
  rw [mappingConeIdContractionCochain_fst_app A]
  rw [mappingConeAction_snd]
  rw [Cochain.comp_assoc_of_second_is_zero_cochain]
  rw [mappingConeAction_fst]
  rw [← Cochain.comp_assoc_of_third_is_zero_cochain]
  rw [← TensorCochain.right_comp]
  rw [mappingConeIdContractionCochain_fst_app A]

set_option backward.isDefEq.respectTransparency false in
lemma mappingConeIdContraction_naturality_snd
    (M : RightModule (R := R) A) (X Y : A) :
    ((Cochain.ofHom (mappingConeAction A (𝟙 M) X Y)).comp
          (mappingConeIdContractionCochain (M.obj X)) (zero_add (-1))).comp
        (CochainComplex.mappingCone.snd (Hom.app (𝟙 M) X)) (add_zero (-1)) =
      ((TensorCochain.right (X ⟶[V] Y)
          (mappingConeIdContractionCochain (M.obj Y))).comp
        (Cochain.ofHom (mappingConeAction A (𝟙 M) X Y))
          (add_zero (-1))).comp
            (CochainComplex.mappingCone.snd (Hom.app (𝟙 M) X))
              (add_zero (-1)) := by
  rw [Cochain.comp_assoc_of_first_is_zero_cochain]
  rw [mappingConeIdContractionCochain_snd_app A]
  simp only [Cochain.comp_zero]
  rw [Cochain.comp_assoc_of_second_is_zero_cochain]
  rw [mappingConeAction_snd]
  rw [← Cochain.comp_assoc_of_third_is_zero_cochain]
  rw [← TensorCochain.right_comp]
  rw [mappingConeIdContractionCochain_snd_app A]
  simp

set_option backward.isDefEq.respectTransparency false in
/-- The standard contraction cochains commute with the signed mapping-cone action. -/
lemma mappingConeIdContraction_naturality
    (M : RightModule (R := R) A) (X Y : A) :
    (Cochain.ofHom (mappingConeAction A (𝟙 M) X Y)).comp
        (mappingConeIdContractionCochain (M.obj X)) (zero_add (-1)) =
      (TensorCochain.right (X ⟶[V] Y)
          (mappingConeIdContractionCochain (M.obj Y))).comp
        (Cochain.ofHom (mappingConeAction A (𝟙 M) X Y))
          (add_zero (-1)) := by
  apply Cochain.ext
  intro p q hpq
  obtain rfl : q = p - 1 := by omega
  apply CochainComplex.mappingCone.ext_to (Hom.app (𝟙 M) X)
    (p - 1) p (by omega)
  · have h := Cochain.congr_v
      (mappingConeIdContraction_naturality_fst A M X Y) p p (add_zero p)
    rw [Cochain.comp_v _ _ (neg_add_cancel 1) p (p - 1) p hpq (by omega)] at h
    exact h
  · have h := Cochain.congr_v
      (mappingConeIdContraction_naturality_snd A M X Y) p (p - 1) (by omega)
    rw [Cochain.comp_v _ _ (add_zero (-1)) p (p - 1) (p - 1) hpq
      (add_zero (p - 1))] at h
    exact h

set_option backward.isDefEq.respectTransparency false in
/-- The cone of the identity of a right DG module is contractible by the standard
pointwise mapping-cone contraction. -/
noncomputable def mappingConeHomotopyToZeroOfId
    (M : RightModule (R := R) A) :
    Homotopy A (𝟙 (mappingCone A (𝟙 M))) 0 where
  app X := by
    change _root_.Homotopy
      (𝟙 (CochainComplex.mappingCone (𝟙 (M.obj X)))) 0
    exact CochainComplex.mappingCone.homotopyToZeroOfId (M.obj X)
  naturality X Y p q := by
    let hX := CochainComplex.mappingCone.homotopyToZeroOfId (M.obj X)
    let hY := CochainComplex.mappingCone.homotopyToZeroOfId (M.obj Y)
    let hTensor := HomologicalComplex.mapBifunctorMapHomotopy₂
      (𝟙 (X ⟶[V] Y)) hY (curriedTensor (ModuleCat R)) (ComplexShape.up ℤ)
    by_cases hpq : p + (-1) = q
    · have h := Cochain.congr_v
        (mappingConeIdContraction_naturality A M X Y) p q hpq
      simp only [Cochain.comp_v _ _ (zero_add (-1)) p p q (add_zero p) hpq,
        Cochain.comp_v _ _ (add_zero (-1)) p q q hpq (add_zero q),
        Cochain.ofHom_v, mappingConeIdContractionCochain,
        Cochain.ofHomotopy, Cochain.mk_v] at h
      have htensor := Cochain.congr_v
        (TensorCochain.right_ofHomotopy (X ⟶[V] Y) hY) p q hpq
      simp only [Cochain.ofHomotopy, Cochain.mk_v] at htensor
      simp only [_root_.Homotopy.compLeft_hom, _root_.Homotopy.compRight_hom]
      change (mappingConeAction A (𝟙 M) X Y).f p ≫ hX.hom p q =
        hTensor.hom p q ≫ (mappingConeAction A (𝟙 M) X Y).f q
      rw [← htensor]
      exact h
    · have hrel : ¬(ComplexShape.up ℤ).Rel q p := by
        intro h
        apply hpq
        simp only [ComplexShape.up_Rel] at h
        omega
      simp only [_root_.Homotopy.compLeft_hom, _root_.Homotopy.compRight_hom]
      change (mappingConeAction A (𝟙 M) X Y).f p ≫ hX.hom p q =
        hTensor.hom p q ≫ (mappingConeAction A (𝟙 M) X Y).f q
      rw [hX.zero p q hrel, hTensor.zero p q hrel]
      simp

end DGCategory.RightModule

open CategoryTheory Limits MonoidalCategory
open CochainComplex.HomComplex

namespace DGCategory.RightModule

variable {R : Type w} [CommRing R]
variable (A : Type u) [DGCategory R A]

local notation "V" => CochainComplex (ModuleCat R) ℤ

/-- The shifted module map with its component formula definitionally exposed. -/
noncomputable def strictShiftMap
    {M N : RightModule (R := R) A} (f : M ⟶ N) (n : ℤ) :
    shift A M n ⟶ shift A N n where
  app X := (f.app X)⟦n⟧'
  naturality X Y := by
    rw [← shiftMap_app A f n X, ← shiftMap_app A f n Y]
    exact (shiftMap A f n).naturality X Y

lemma coneShiftIso_hom_fst {K L : V} (g : K ⟶ L) (n : ℤ) :
    (Cochain.ofHom (CochainComplex.mappingCone.shiftIso g n).hom).comp
        (CochainComplex.mappingCone.fst (g⟦n⟧')).1 (zero_add 1) =
      n.negOnePow • (CochainComplex.mappingCone.fst g).1.shift n := by
  apply Cochain.ext
  intro p q hpq
  dsimp [CochainComplex.mappingCone.shiftIso]
  simp

lemma coneShiftIso_hom_snd {K L : V} (g : K ⟶ L) (n : ℤ) :
    (Cochain.ofHom (CochainComplex.mappingCone.shiftIso g n).hom).comp
        (CochainComplex.mappingCone.snd (g⟦n⟧')) (zero_add 0) =
      (CochainComplex.mappingCone.snd g).shift n := by
  apply Cochain.ext
  intro p q hpq
  dsimp [CochainComplex.mappingCone.shiftIso]
  simp
  rfl

lemma tensor_coneShiftIso_hom_fst (H : V) {K L : V} (g : K ⟶ L) (n : ℤ) :
    (Cochain.ofHom (H ◁ (CochainComplex.mappingCone.shiftIso g n).hom)).comp
        (TensorCochain.right H (CochainComplex.mappingCone.fst (g⟦n⟧')).1)
          (zero_add 1) =
      TensorCochain.right H
        (n.negOnePow • (CochainComplex.mappingCone.fst g).1.shift n) := by
  rw [← TensorCochain.right_ofHom]
  rw [← TensorCochain.right_comp]
  rw [coneShiftIso_hom_fst]

lemma tensor_coneShiftIso_hom_snd (H : V) {K L : V} (g : K ⟶ L) (n : ℤ) :
    (Cochain.ofHom (H ◁ (CochainComplex.mappingCone.shiftIso g n).hom)).comp
        (TensorCochain.right H (CochainComplex.mappingCone.snd (g⟦n⟧')))
          (zero_add 0) =
      TensorCochain.right H ((CochainComplex.mappingCone.snd g).shift n) := by
  rw [← TensorCochain.right_ofHom]
  rw [← TensorCochain.right_comp]
  rw [coneShiftIso_hom_snd]

/-- The first cone projection as a degree-one graded module morphism. -/
def mappingConeFstGradedHom
    {M N : RightModule (R := R) A} (f : M ⟶ N) :
    GradedHom A (mappingCone A f) M 1 where
  app X := (CochainComplex.mappingCone.fst (f.app X)).1
  naturality X Y := mappingConeAction_fst A f X Y

/-- The second cone projection as a degree-zero graded module morphism. -/
def mappingConeSndGradedHom
    {M N : RightModule (R := R) A} (f : M ⟶ N) :
    GradedHom A (mappingCone A f) N 0 where
  app X := CochainComplex.mappingCone.snd (f.app X)
  naturality X Y := mappingConeAction_snd A f X Y

set_option maxHeartbeats 2000000 in
-- Elaborating the componentwise cone-shift naturality proof exceeds the default budget.
set_option backward.isDefEq.respectTransparency false in
/-- The canonical cone-shift morphism, first stated for the definitionally exposed
shifted module map. -/
noncomputable def coneShiftHomStrict
    {M N : RightModule (R := R) A} (f : M ⟶ N) (n : ℤ) :
    shift A (mappingCone A f) n ⟶ mappingCone A (strictShiftMap A f n) where
  app X := by
    exact (CochainComplex.mappingCone.shiftIso (f.app X) n).hom
  naturality X Y := by
    rw [shift_action]
    change
      shiftAction A (mappingCone A f) n X Y ≫
          (CochainComplex.mappingCone.shiftIso (f.app X) n).hom =
        (X ⟶[V] Y) ◁ (CochainComplex.mappingCone.shiftIso (f.app Y) n).hom ≫
          mappingConeAction A (strictShiftMap A f n) X Y
    dsimp only [strictShiftMap]
    apply HomologicalComplex.Hom.ext
    funext p
    apply CochainComplex.mappingCone.ext_to ((f.app X)⟦n⟧') p (p + 1) rfl
    · simp only [HomologicalComplex.comp_f, Category.assoc]
      dsimp [CochainComplex.mappingCone.shiftIso]
      slice_lhs 2 3 => rw [CochainComplex.mappingCone.lift_f_fst_v]
      have hact := Cochain.congr_v
        (mappingConeAction_fst A (strictShiftMap A f n) X Y) p (p + 1) rfl
      simp only [Cochain.comp_v _ _ (zero_add 1) p p (p + 1) (add_zero p) rfl,
        Cochain.comp_v _ _ (add_zero 1) p (p + 1) (p + 1) rfl
          (add_zero (p + 1)), Cochain.ofHom_v] at hact
      dsimp [strictShiftMap] at hact
      slice_rhs 2 3 => rw [hact]
      have hcone := Cochain.congr_v
        (tensor_coneShiftIso_hom_fst (X ⟶[V] Y) (f.app Y) n)
          p (p + 1) rfl
      simp only [Cochain.comp_v _ _ (zero_add 1) p p (p + 1) (add_zero p) rfl,
        Cochain.ofHom_v] at hcone
      dsimp [CochainComplex.mappingCone.shiftIso] at hcone
      slice_rhs 1 2 => rw [hcone]
      let η := GradedHom.shift A (mappingConeFstGradedHom A f) n
        (fun X Y ↦ shift_action A (mappingCone A f) n X Y)
        (fun X Y ↦ shift_action A M n X Y)
      have hshift := (n.negOnePow • η).naturality X Y
      have happ (Z : A) : (n.negOnePow • η).app Z = n.negOnePow • η.app Z := rfl
      rw [happ X, happ Y] at hshift
      dsimp [η, GradedHom.shift, mappingConeFstGradedHom] at hshift
      rw [shift_action, shift_action] at hshift
      have hv := Cochain.congr_v hshift p (p + 1) rfl
      simp only [Cochain.comp_v _ _ (zero_add 1) p p (p + 1) (add_zero p) rfl,
        Cochain.comp_v _ _ (add_zero 1) p (p + 1) (p + 1) rfl
          (add_zero (p + 1)), Cochain.ofHom_v] at hv
      rw [shift_action]
      have hM (Z : A) : (shift A M n).obj Z = (M.obj Z)⟦n⟧ := rfl
      have hCone (Z : A) :
          (shift A (mappingCone A f) n).obj Z = ((mappingCone A f).obj Z)⟦n⟧ := rfl
      simpa only [Cocycle.coe_units_smul, Cocycle.shift_coe, hM, hCone] using hv
    · simp only [HomologicalComplex.comp_f, Category.assoc]
      dsimp [CochainComplex.mappingCone.shiftIso]
      slice_lhs 2 3 => rw [CochainComplex.mappingCone.lift_f_snd_v]
      have hact := Cochain.congr_v
        (mappingConeAction_snd A (strictShiftMap A f n) X Y) p p (add_zero p)
      simp only [Cochain.comp_v _ _ (zero_add 0) p p p (add_zero p) (add_zero p),
        Cochain.ofHom_v] at hact
      dsimp [strictShiftMap] at hact
      slice_rhs 2 3 => rw [hact]
      have hcone := Cochain.congr_v
        (tensor_coneShiftIso_hom_snd (X ⟶[V] Y) (f.app Y) n)
          p p (add_zero p)
      simp only [Cochain.comp_v _ _ (zero_add 0) p p p (add_zero p) (add_zero p),
        Cochain.ofHom_v] at hcone
      dsimp [CochainComplex.mappingCone.shiftIso] at hcone
      slice_rhs 1 2 => rw [hcone]
      have hshift :=
        (GradedHom.shift A (mappingConeSndGradedHom A f) n
          (fun X Y ↦ shift_action A (mappingCone A f) n X Y)
          (fun X Y ↦ shift_action A N n X Y)).naturality X Y
      dsimp [GradedHom.shift, mappingConeSndGradedHom] at hshift
      rw [shift_action, shift_action] at hshift
      have hv := Cochain.congr_v hshift p p (add_zero p)
      rw [shift_action]
      simpa only [Cochain.comp_v _ _ (zero_add 0) p p p (add_zero p) (add_zero p),
        Cochain.ofHom_v] using hv

set_option backward.isDefEq.respectTransparency false in
/-- The inverse of `coneShiftHomStrict`, assembled from the pointwise cone-shift
isomorphisms. -/
noncomputable def coneShiftInvStrict
    {M N : RightModule (R := R) A} (f : M ⟶ N) (n : ℤ) :
    mappingCone A (strictShiftMap A f n) ⟶ shift A (mappingCone A f) n where
  app X := (CochainComplex.mappingCone.shiftIso (f.app X) n).inv
  naturality X Y := by
    rw [← cancel_mono (CochainComplex.mappingCone.shiftIso (f.app X) n).hom]
    rw [shift_action]
    change
      mappingConeAction A (strictShiftMap A f n) X Y ≫
          (CochainComplex.mappingCone.shiftIso (f.app X) n).inv ≫
            (CochainComplex.mappingCone.shiftIso (f.app X) n).hom =
        (X ⟶[V] Y) ◁ (CochainComplex.mappingCone.shiftIso (f.app Y) n).inv ≫
          shiftAction A (mappingCone A f) n X Y ≫
            (CochainComplex.mappingCone.shiftIso (f.app X) n).hom
    simp only [Iso.inv_hom_id, Category.comp_id]
    have hnat := (coneShiftHomStrict A f n).naturality X Y
    rw [shift_action] at hnat
    change
      shiftAction A (mappingCone A f) n X Y ≫
          (CochainComplex.mappingCone.shiftIso (f.app X) n).hom =
        (X ⟶[V] Y) ◁ (CochainComplex.mappingCone.shiftIso (f.app Y) n).hom ≫
          mappingConeAction A (strictShiftMap A f n) X Y at hnat
    rw [hnat]
    have hwhisk :
        ((X ⟶[V] Y) ◁ (CochainComplex.mappingCone.shiftIso (f.app Y) n).inv) ≫
            ((X ⟶[V] Y) ◁ (CochainComplex.mappingCone.shiftIso (f.app Y) n).hom) =
          𝟙 ((X ⟶[V] Y) ⊗ CochainComplex.mappingCone ((f.app Y)⟦n⟧')) := by
      rw [← MonoidalCategory.whiskerLeft_comp]
      simp
    rw [← Category.assoc, hwhisk, Category.id_comp]

set_option backward.isDefEq.respectTransparency false in
/-- Objectwise shifting commutes with objectwise mapping cones, first stated for the
definitionally exposed shifted module map. -/
noncomputable def coneShiftIsoStrict
    {M N : RightModule (R := R) A} (f : M ⟶ N) (n : ℤ) :
    shift A (mappingCone A f) n ≅ mappingCone A (strictShiftMap A f n) where
  hom := coneShiftHomStrict A f n
  inv := coneShiftInvStrict A f n
  hom_inv_id := by
    apply Hom.ext
    funext X
    exact (CochainComplex.mappingCone.shiftIso (f.app X) n).hom_inv_id
  inv_hom_id := by
    apply Hom.ext
    funext X
    exact (CochainComplex.mappingCone.shiftIso (f.app X) n).inv_hom_id

end DGCategory.RightModule

/-! ## Rotation of standard mapping-cone triangles -/

namespace DGCategory.RightModule

variable {R : Type w} [CommRing R]
variable (A : Type u) [DGCategory R A]

local notation "V" => CochainComplex (ModuleCat R) ℤ

open CochainComplex.HomComplex

section CochainComplexFormulas

variable {K L : CochainComplex (ModuleCat.{w} R) ℤ} (f : K ⟶ L)

/-- First matrix component of the forward rotation homotopy equivalence. -/
lemma rotateHomotopyEquiv_hom_fst :
    (Cochain.ofHom (CochainComplex.mappingCone.rotateHomotopyEquiv f).hom).comp
        (CochainComplex.mappingCone.fst
          (CochainComplex.mappingCone.inr f)).1 (zero_add 1) =
      -(CochainComplex.HomComplex.Cocycle.ofHom f).1.leftShift
        1 1 (zero_add 1) := by
  simp [CochainComplex.mappingCone.rotateHomotopyEquiv]

/-- Second matrix component of the forward rotation homotopy equivalence. -/
lemma rotateHomotopyEquiv_hom_snd :
    (Cochain.ofHom (CochainComplex.mappingCone.rotateHomotopyEquiv f).hom).comp
        (CochainComplex.mappingCone.snd
          (CochainComplex.mappingCone.inr f)) (zero_add 0) =
      -(CochainComplex.mappingCone.inl f).leftShift
        1 0 (neg_add_cancel 1) := by
  simp [CochainComplex.mappingCone.rotateHomotopyEquiv]

/-- Tensoring the first forward rotation matrix formula preserves its form. -/
lemma tensor_rotateHomotopyEquiv_hom_fst (T : V) :
    (Cochain.ofHom
        (T ◁ (CochainComplex.mappingCone.rotateHomotopyEquiv f).hom)).comp
      (TensorCochain.right T
        (CochainComplex.mappingCone.fst
          (CochainComplex.mappingCone.inr f)).1) (zero_add 1) =
      TensorCochain.right T
        (-(CochainComplex.HomComplex.Cocycle.ofHom f).1.leftShift
          1 1 (zero_add 1)) := by
  rw [← TensorCochain.right_ofHom]
  rw [← TensorCochain.right_comp]
  rw [rotateHomotopyEquiv_hom_fst]

/-- Tensoring the second forward rotation matrix formula preserves its form. -/
lemma tensor_rotateHomotopyEquiv_hom_snd (T : V) :
    (Cochain.ofHom
        (T ◁ (CochainComplex.mappingCone.rotateHomotopyEquiv f).hom)).comp
      (TensorCochain.right T
        (CochainComplex.mappingCone.snd
          (CochainComplex.mappingCone.inr f))) (zero_add 0) =
      TensorCochain.right T
        (-(CochainComplex.mappingCone.inl f).leftShift
          1 0 (neg_add_cancel 1)) := by
  rw [← TensorCochain.right_ofHom]
  rw [← TensorCochain.right_comp]
  rw [rotateHomotopyEquiv_hom_snd]

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- The cochain of the inverse rotation map factors through the second cone
projection and the third map of the original cone triangle. -/
lemma cochain_ofHom_rotateHomotopyEquiv_inv :
    Cochain.ofHom (CochainComplex.mappingCone.rotateHomotopyEquiv f).inv =
      (CochainComplex.mappingCone.snd
        (CochainComplex.mappingCone.inr f)).comp
          (Cochain.ofHom (CochainComplex.mappingCone.triangle f).mor₃)
          (zero_add 0) := by
  dsimp [CochainComplex.mappingCone.rotateHomotopyEquiv]
  erw [CochainComplex.mappingCone.ofHom_desc]
  simp [CochainComplex.mappingCone.descCochain]

/-- Explicit degree-minus-one cochain in the deformation retraction used for rotation. -/
noncomputable abbrev rotateInvHomIdCochain :
    Cochain
      (CochainComplex.mappingCone (CochainComplex.mappingCone.inr f))
      (CochainComplex.mappingCone (CochainComplex.mappingCone.inr f)) (-1) :=
  -(CochainComplex.mappingCone.snd (CochainComplex.mappingCone.inr f)).comp
    ((CochainComplex.mappingCone.snd f).comp
      (CochainComplex.mappingCone.inl (CochainComplex.mappingCone.inr f))
        (zero_add (-1))) (zero_add (-1))

/-- The ordinary rotation deformation homotopy has the explicit matrix above. -/
lemma cochain_ofHomotopy_rotateHomotopyEquiv_inv_hom_id :
    Cochain.ofHomotopy
        (CochainComplex.mappingCone.rotateHomotopyEquiv f).homotopyInvHomId =
      rotateInvHomIdCochain f := by
  apply Cochain.ext
  intro p q hpq
  dsimp only [Cochain.ofHomotopy, Cochain.mk_v]
  dsimp only [CochainComplex.mappingCone.rotateHomotopyEquiv]
  rw [Cochain.equivHomotopy_symm_apply_hom, dif_pos hpq]

/-- The rotation deformation cochain, followed by the first cone projection,
is the negative composite of the two second cone projections. -/
lemma rotateInvHomIdCochain_fst :
    (rotateInvHomIdCochain f).comp
        (CochainComplex.mappingCone.fst
          (CochainComplex.mappingCone.inr f)).1 (neg_add_cancel 1) =
      -((CochainComplex.mappingCone.snd
          (CochainComplex.mappingCone.inr f)).comp
        (CochainComplex.mappingCone.snd f) (zero_add 0)) := by
  simp only [rotateInvHomIdCochain, Cochain.neg_comp]
  rw [Cochain.comp_assoc_of_second_degree_eq_neg_third_degree]
  simp

/-- The rotation deformation cochain vanishes after the second cone projection. -/
lemma rotateInvHomIdCochain_snd :
    (rotateInvHomIdCochain f).comp
        (CochainComplex.mappingCone.snd
          (CochainComplex.mappingCone.inr f)) (add_zero (-1)) = 0 := by
  simp only [rotateInvHomIdCochain, Cochain.neg_comp]
  rw [Cochain.comp_assoc_of_third_is_zero_cochain]
  simp

/-- The explicit deformation cochain witnessing the middle square in the
rotation of a standard cone triangle. -/
noncomputable abbrev rotateComm₂Cochain :
    Cochain (CochainComplex.mappingCone f)
      (CochainComplex.mappingCone (CochainComplex.mappingCone.inr f)) (-1) :=
  -(CochainComplex.mappingCone.snd f).comp
    (CochainComplex.mappingCone.inl (CochainComplex.mappingCone.inr f))
      (zero_add (-1))

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- The ordinary homotopy used in the middle rotation square has the explicit
cochain above. -/
lemma cochain_ofHomotopy_rotateHomotopyEquivComm₂Homotopy :
    Cochain.ofHomotopy
        (CochainComplex.mappingCone.rotateHomotopyEquivComm₂Homotopy f) =
      rotateComm₂Cochain f := by
  apply Cochain.ext
  intro p q hpq
  dsimp only [Cochain.ofHomotopy, Cochain.mk_v]
  dsimp only [CochainComplex.mappingCone.rotateHomotopyEquivComm₂Homotopy]
  rw [Cochain.equivHomotopy_symm_apply_hom, dif_pos hpq]

/-- The middle-square deformation cochain restricts to the negative second
projection on the shifted summand. -/
lemma rotateComm₂Cochain_fst :
    (rotateComm₂Cochain f).comp
        (CochainComplex.mappingCone.fst
          (CochainComplex.mappingCone.inr f)).1 (neg_add_cancel 1) =
      -(CochainComplex.mappingCone.snd f) := by
  simp only [rotateComm₂Cochain, Cochain.neg_comp]
  rw [Cochain.comp_assoc_of_second_degree_eq_neg_third_degree]
  simp

/-- The middle-square deformation cochain vanishes after the second cone
projection. -/
lemma rotateComm₂Cochain_snd :
    (rotateComm₂Cochain f).comp
        (CochainComplex.mappingCone.snd
          (CochainComplex.mappingCone.inr f)) (add_zero (-1)) = 0 := by
  simp only [rotateComm₂Cochain, Cochain.neg_comp]
  rw [Cochain.comp_assoc_of_third_is_zero_cochain]
  simp

end CochainComplexFormulas

section ModuleRotationFormulas

variable {M N : RightModule (R := R) A} (f : M ⟶ N)

/-- The degree-one first matrix component of the forward rotation map. -/
noncomputable abbrev rotateHomFstCochain (X : A) :
    Cochain ((CategoryTheory.shiftFunctor V (1 : ℤ)).obj (M.obj X)) (N.obj X) 1 :=
  -(CochainComplex.HomComplex.Cocycle.ofHom (f.app X)).1.leftShift
    1 1 (zero_add 1)

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.types false in
/-- The first rotation matrix component is a graded module-natural transformation. -/
lemma rotateHomFstCochain_naturality (X Y : A) :
    (Cochain.ofHom (shiftAction A M 1 X Y)).comp
        (rotateHomFstCochain A f X) (zero_add 1) =
      (TensorCochain.right (X ⟶[V] Y) (rotateHomFstCochain A f Y)).comp
        (Cochain.ofHom (N.action X Y)) (add_zero 1) := by
  apply Cochain.ext
  intro p q hpq
  subst q
  apply HomologicalComplex.mapBifunctor.hom_ext
  intro i j hij
  rw [Cochain.comp_v _ _ (zero_add 1) p p (p + 1) (add_zero p) rfl]
  rw [Cochain.comp_v _ _ (add_zero 1) p (p + 1) (p + 1) rfl
    (add_zero (p + 1))]
  simp only [Cochain.ofHom_v]
  change _ ≫ (shiftAction A M 1 X Y).f p ≫
      (rotateHomFstCochain A f X).v p (p + 1) rfl = _
  dsimp only [shiftAction]
  rw [HomologicalComplex.comp_f]
  simp only [Category.assoc]
  slice_lhs 1 2 =>
    rw [CochainComplex.ι_mapBifunctorShift₂Iso_hom_f
      (X ⟶[V] Y) (M.obj Y) (curriedTensor (ModuleCat R)) 1 i j p hij
        (j + 1) (p + 1) rfl rfl]
  simp only [Linear.units_smul_comp, Category.assoc]
  rw [TensorCochain.ι_right_v_assoc (X ⟶[V] Y)
    (rotateHomFstCochain A f Y) i j p (p + 1) hij rfl]
  simp only [rotateHomFstCochain, Cocycle.ofHom_coe, Cochain.neg_v,
    Cochain.leftShift_v, Cochain.ofHom_v, mul_one, one_mul, sub_self, Int.zero_ediv,
    add_zero, Int.negOnePow_one, Units.neg_smul, one_smul, neg_neg,
    CochainComplex.shiftFunctor_obj_X', CochainComplex.shiftFunctorObjXIso,
    CochainComplex.shiftFunctor_map_f', HomologicalComplex.XIsoOfEq_rfl,
    Iso.refl_hom, Iso.refl_inv, Category.id_comp, Linear.units_smul_comp]
  rw [smul_left_cancel_iff]
  change
    ((curriedTensor (ModuleCat R)).obj ((X ⟶[V] Y).X i)).map
          (𝟙 ((M.obj Y).X (j + 1))) ≫
        HomologicalComplex.ιMapBifunctor (X ⟶[V] Y) (M.obj Y)
          (curriedTensor (ModuleCat R)) (ComplexShape.up ℤ)
          i (j + 1) (p + 1) (by dsimp at hij ⊢; omega) ≫
        (M.action X Y).f (p + 1) ≫ 𝟙 ((M.obj X).X (p + 1)) ≫
        (f.app X).f (p + 1) =
      ((X ⟶[V] Y).X i ◁
          (𝟙 ((M.obj Y).X (j + 1)) ≫ (f.app Y).f (j + 1))) ≫
        HomologicalComplex.ιMapBifunctor (X ⟶[V] Y) (N.obj Y)
          (curriedTensor (ModuleCat R)) (ComplexShape.up ℤ)
          i (j + 1) (p + 1) (by dsimp at hij ⊢; omega) ≫
        (N.action X Y).f (p + 1)
  rw [show ((curriedTensor (ModuleCat R)).obj ((X ⟶[V] Y).X i)).map
      (𝟙 ((M.obj Y).X (j + 1))) = 𝟙 _ by simp]
  simp only [Category.id_comp]
  have hnat := congrArg (fun k ↦ k.f (p + 1)) (f.naturality X Y)
  simp only [HomologicalComplex.comp_f] at hnat
  slice_lhs 2 3 => rw [hnat]
  have hid := congrArg (fun k ↦ k.f (p + 1))
    (MonoidalCategory.id_tensorHom (X ⟶[V] Y) (f.app Y))
  rw [← hid]
  erw [HomologicalComplex.ι_mapBifunctorMap_assoc]
  simp only [HomologicalComplex.id_f]
  have hmapid :
      ((curriedTensor (ModuleCat R)).map (𝟙 ((X ⟶[V] Y).X i))).app
          ((M.obj Y).X (j + 1)) = 𝟙 _ := by
    simpa only [NatTrans.id_app] using congrArg
      (fun k ↦ k.app ((M.obj Y).X (j + 1)))
      ((curriedTensor (ModuleCat R)).map_id ((X ⟶[V] Y).X i))
  rw [hmapid, Category.id_comp]
  rfl

/-- The degree-zero second matrix component of the forward rotation map. -/
noncomputable abbrev rotateHomSndCochain (X : A) :
    Cochain ((CategoryTheory.shiftFunctor V (1 : ℤ)).obj (M.obj X))
      (CochainComplex.mappingCone (f.app X)) 0 :=
  -(CochainComplex.mappingCone.inl (f.app X)).leftShift
    1 0 (neg_add_cancel 1)

/-- The shifted cone inclusion is the identity on the shifted-source matrix component. -/
lemma rotateHomSndCochain_fst (X : A) :
    (rotateHomSndCochain A f X).comp
        (CochainComplex.mappingCone.fst (f.app X)).1 (zero_add 1) =
      (Cochain.ofHom (𝟙 (M.obj X))).leftShift 1 1 (zero_add 1) := by
  have h := Cochain.leftShift_comp
    (CochainComplex.mappingCone.inl (f.app X)) 1 0 (neg_add_cancel 1)
    (CochainComplex.mappingCone.fst (f.app X)).1
    (neg_add_cancel 1) (zero_add 1)
  simpa only [rotateHomSndCochain, Cochain.neg_comp, one_mul,
    Int.negOnePow_one, Units.neg_smul, one_smul,
    CochainComplex.mappingCone.inl_fst] using h.symm

/-- The shifted cone inclusion vanishes on the unshifted-target matrix component. -/
lemma rotateHomSndCochain_snd (X : A) :
    (rotateHomSndCochain A f X).comp
        (CochainComplex.mappingCone.snd (f.app X)) (zero_add 0) = 0 := by
  have h := Cochain.leftShift_comp
    (CochainComplex.mappingCone.inl (f.app X)) 1 0 (neg_add_cancel 1)
    (CochainComplex.mappingCone.snd (f.app X)) (add_zero (-1))
    (neg_add_cancel 1)
  have hzero :
      ((CochainComplex.mappingCone.inl (f.app X)).leftShift
        1 0 (neg_add_cancel 1)).comp
          (CochainComplex.mappingCone.snd (f.app X)) (zero_add 0) = 0 := by
    simpa only [mul_zero, Int.negOnePow_zero, one_smul,
      CochainComplex.mappingCone.inl_snd, Cochain.leftShift_zero] using h.symm
  simp only [rotateHomSndCochain, Cochain.neg_comp, hzero, neg_zero]

/-- The shifted identity cochain is natural for the transported module action. -/
lemma shiftedIdentityCochain_naturality (X Y : A) :
    (Cochain.ofHom (shiftAction A M 1 X Y)).comp
        ((Cochain.ofHom (𝟙 (M.obj X))).leftShift 1 1 (zero_add 1))
        (zero_add 1) =
      (TensorCochain.right (X ⟶[V] Y)
          ((Cochain.ofHom (𝟙 (M.obj Y))).leftShift 1 1 (zero_add 1))).comp
        (Cochain.ofHom (M.action X Y)) (add_zero 1) := by
  have h := congrArg Neg.neg
    (rotateHomFstCochain_naturality A (𝟙 M) X Y)
  have hX : (𝟙 M : M ⟶ M).app X = 𝟙 (M.obj X) := rfl
  have hY : (𝟙 M : M ⟶ M).app Y = 𝟙 (M.obj Y) := rfl
  simpa only [rotateHomFstCochain, hX, hY, Cocycle.ofHom_coe,
    Cochain.comp_neg, TensorCochain.right_neg, Cochain.neg_comp,
    neg_neg] using h

/-- Tensoring the second rotation component preserves its first matrix projection. -/
lemma tensor_rotateHomSndCochain_fst (H : V) (X : A) :
    (TensorCochain.right H (rotateHomSndCochain A f X)).comp
        (TensorCochain.right H
          (CochainComplex.mappingCone.fst (f.app X)).1) (zero_add 1) =
      TensorCochain.right H
        ((Cochain.ofHom (𝟙 (M.obj X))).leftShift 1 1 (zero_add 1)) := by
  rw [← TensorCochain.right_comp]
  rw [rotateHomSndCochain_fst]

/-- Tensoring the second rotation component preserves its vanishing second projection. -/
lemma tensor_rotateHomSndCochain_snd (H : V) (X : A) :
    (TensorCochain.right H (rotateHomSndCochain A f X)).comp
        (TensorCochain.right H
          (CochainComplex.mappingCone.snd (f.app X))) (zero_add 0) = 0 := by
  rw [← TensorCochain.right_comp]
  rw [rotateHomSndCochain_snd]
  simp

/-- The second rotation matrix component is a graded module-natural transformation. -/
lemma rotateHomSndCochain_naturality (X Y : A) :
    (Cochain.ofHom (shiftAction A M 1 X Y)).comp
        (rotateHomSndCochain A f X) (zero_add 0) =
      (TensorCochain.right (X ⟶[V] Y)
          (rotateHomSndCochain A f Y)).comp
        (Cochain.ofHom (mappingConeAction A f X Y)) (add_zero 0) := by
  apply Cochain.ext
  intro p q hpq
  obtain rfl : p = q := by omega
  apply CochainComplex.mappingCone.ext_to (f.app X) p (p + 1) rfl
  · have hbetaX := Cochain.congr_v (rotateHomSndCochain_fst A f X)
      p (p + 1) rfl
    have hbetaY := Cochain.congr_v
      (tensor_rotateHomSndCochain_fst A f (X ⟶[V] Y) Y) p (p + 1) rfl
    have haction := Cochain.congr_v (mappingConeAction_fst A f X Y)
      p (p + 1) rfl
    have hid := Cochain.congr_v
      (shiftedIdentityCochain_naturality (M := M) A X Y)
      p (p + 1) rfl
    simp only [Cochain.comp_v _ _ (zero_add 1) p p (p + 1)
        (add_zero p) rfl,
      Cochain.comp_v _ _ (add_zero 1) p (p + 1) (p + 1)
        rfl (add_zero (p + 1)), Cochain.ofHom_v] at hbetaX hbetaY haction hid
    simp only [Cochain.comp_v _ _ (zero_add 0) p p p
      (add_zero p) (add_zero p), Cochain.ofHom_v, Category.assoc]
    slice_lhs 2 3 => rw [hbetaX]
    slice_rhs 2 3 => rw [haction]
    slice_rhs 1 2 => rw [hbetaY]
    exact hid
  · have hbetaX := Cochain.congr_v (rotateHomSndCochain_snd A f X)
      p p (add_zero p)
    have hbetaY := Cochain.congr_v
      (tensor_rotateHomSndCochain_snd A f (X ⟶[V] Y) Y) p p (add_zero p)
    have haction := Cochain.congr_v (mappingConeAction_snd A f X Y)
      p p (add_zero p)
    simp only [Cochain.comp_v _ _ (zero_add 0) p p p
        (add_zero p) (add_zero p), Cochain.ofHom_v] at hbetaX hbetaY haction
    simp only [Cochain.comp_v _ _ (zero_add 0) p p p
      (add_zero p) (add_zero p), Cochain.ofHom_v, Category.assoc]
    slice_lhs 2 3 => rw [hbetaX]
    simp only [Cochain.zero_v, Limits.comp_zero]
    slice_rhs 2 3 => rw [haction]
    slice_rhs 1 2 => rw [hbetaY]
    simp only [Cochain.zero_v, Limits.zero_comp]

