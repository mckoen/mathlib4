/-- The forward rotation map followed by its inverse is strictly the identity. -/
lemma rotateHom_comp_rotateInv :
    rotateHom A f ≫ rotateInv A f = 𝟙 (shift A M 1) := by
  apply Hom.ext
  funext X
  change
    (CochainComplex.mappingCone.rotateHomotopyEquiv (f.app X)).hom ≫
        (CochainComplex.mappingCone.rotateHomotopyEquiv (f.app X)).inv =
      𝟙 ((CategoryTheory.shiftFunctor V (1 : ℤ)).obj (M.obj X))
  dsimp [CochainComplex.mappingCone.rotateHomotopyEquiv]
  ext n
  simp only [CochainComplex.shiftFunctor_obj_X', Int.reduceNeg,
    HomologicalComplex.comp_f,
    CochainComplex.mappingCone.lift_desc_f _ _ _ _ _ _ _ _ _ rfl,
    Cocycle.coe_neg, Cocycle.leftShift_coe, Cocycle.ofHom_coe, Cochain.neg_v,
    Cochain.zero_v, Limits.comp_zero,
    (CochainComplex.mappingCone.inl (f.app X)).leftShift_v
      1 0 _ _ n _ (n + 1) (by simp only [add_neg_cancel_right]),
    CochainComplex.shiftFunctor_obj_X, mul_zero, sub_self, Int.zero_ediv, add_zero,
    Int.negOnePow_zero, CochainComplex.shiftFunctorObjXIso,
    HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.id_comp, one_smul,
    Preadditive.neg_comp, CochainComplex.mappingCone.inl_v_triangle_mor₃_f,
    Iso.refl_inv, neg_neg, zero_add, HomologicalComplex.id_f]

/-- The strict forward-inverse identity, regarded as a module homotopy. -/
noncomputable def rotateHomInvIdHomotopy :
    Homotopy A (rotateHom A f ≫ rotateInv A f) (𝟙 (shift A M 1)) :=
  Homotopy.ofEq A (rotateHom_comp_rotateInv A f)

/-- The standard rotation matrices form a genuine homotopy equivalence of
right DG modules. -/
noncomputable def rotateHomotopyEquiv :
    RightModule.HomotopyEquiv A (shift A M 1)
      (mappingCone A (mappingConeInr A f)) where
  hom := rotateHom A f
  inv := rotateInv A f
  homotopyHomInvId := rotateHomInvIdHomotopy A f
  homotopyInvHomId := rotateInvHomIdHomotopy A f

end ModuleRotation

