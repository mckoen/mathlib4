      (quotient (R := R) A).map
        (mappingConeInr A (mappingConeInr A f)) := by
  rw [RightModule.mappingConeToShift_eq]
  rw [← (quotient (R := R) A).map_comp]
  exact eq_of_homotopy _ _ (RightModule.rotateComm₂Homotopy A f)

